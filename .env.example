RAILS_ENV=development
DATABASE_URL=postgres://store_brief:store_brief@db:5432/store_brief_development
SMTP_ADDRESS=mail
SMTP_PORT=1025

# Active Storage: local | amazon
ACTIVE_STORAGE_SERVICE=local

# Amazon S3 (required when ACTIVE_STORAGE_SERVICE=amazon)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=storebrief-uploads-development

# Optional — S3-compatible stores (MinIO, LocalStack)
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true

# Apex host and TLD label count. localhost uses TLD length 0 so atlas.localhost works.
APP_HOST=localhost
APP_TLD_LENGTH=0
# Optional public origin for SAML SP URLs (defaults to http(s)://{APP_HOST})
# APP_URL=http://localhost:3001

# Web Push (PWA). Generate with: bin/rails web_push:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@storebrief.app
