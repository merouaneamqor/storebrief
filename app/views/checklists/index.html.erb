<% content_for :title, "#{t('checklists.title')} · Vazivo" %>

<div class="page-head">
  <div>
    <h1><%= t("checklists.title") %></h1>
    <p class="lede" style="margin-bottom:0;"><%= t("checklists.lede", tenant: current_tenant.name) %></p>
  </div>
  <%= link_to t("checklists.new_from_template"), templates_path, class: "btn" %>
</div>

<section class="panel">
  <% if @checklists.any? %>
    <ul class="list">
      <% @checklists.each do |checklist| %>
        <li>
          <div>
            <%= link_to checklist.title, checklist %>
            <div class="meta"><%= localized_badge(checklist.status) %></div>
          </div>
          <% if checklist.sent? %>
            <%= render "shared/progress", stats: checklist.completion_stats %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t("checklists.empty") %></p>
  <% end %>
</section>
