<% content_for :title, "#{@checklist.title} · Vazivo" %>

<p class="meta"><%= link_to t("checklists.back"), checklists_path %></p>
<h1><%= @checklist.title %></h1>
<p class="lede"><%= localized_badge(@checklist.status) %></p>

<% if @checklist.description.present? %>
  <section class="panel"><div class="prose"><%= @checklist.description %></div></section>
<% end %>

<section class="panel">
  <h2>Items</h2>
  <ul class="list">
    <% @checklist.checklist_items.each do |item| %>
      <li>
        <span><%= item.title %></span>
        <% if item.required? %><span class="badge"><%= t("templates.fields.required") %></span><% end %>
        <% if item.requires_photo? %><span class="badge"><%= t("checklists.requires_photo") %></span><% end %>

      </li>
    <% end %>
  </ul>
</section>

<% if @checklist.sent? %>
  <section class="panel">
    <h2><%= t("checklists.delivery") %></h2>
    <%= render "shared/progress", stats: @stats %>
    <% pending_count = @deliveries.count { |d| d.pending? } %>
    <% if pending_count.positive? && current_tenant.feature?(:push_alerts) %>
      <div class="hq-push-remind">
        <%= button_to notify_push_checklist_path(@checklist),
              method: :post,
              class: "btn",
              data: { turbo_confirm: t("communications.notify_push_confirm", count: pending_count) } do %>
          <%= icon("send", css_class: "icon") %>
          <%= t("communications.notify_push") %>
        <% end %>
        <p class="meta"><%= t("communications.notify_push_hint", count: pending_count) %></p>
      </div>
    <% end %>
    <ul class="list checklist-hq-deliveries">
      <% @deliveries.each do |delivery| %>
        <% responses = delivery.checklist_item_responses.index_by(&:checklist_item_id) %>
        <li id="store-<%= delivery.org_unit_id %>" class="checklist-hq-delivery">
          <div class="checklist-hq-delivery__head">
            <span><%= delivery.org_unit.name %></span>
            <%= localized_badge(delivery.status) %>
          </div>
          <ul class="checklist-hq-evidence">
            <% (@items || @checklist.checklist_items).each do |item| %>
              <% response = responses[item.id] %>
              <li class="checklist-hq-evidence__item">
                <div class="checklist-hq-evidence__label">
                  <span><%= item.title %></span>
                  <% if item.requires_photo? && !response&.evidence_attached? %>
                    <span class="badge badge--missing-evidence"><%= t("checklists.missing_evidence") %></span>
                  <% elsif item.requires_photo? %>
                    <span class="badge"><%= t("checklists.requires_photo") %></span>
                  <% end %>
                </div>
                <% if response&.evidence_attached? %>
                  <div class="checklist-hq-evidence__media">
                    <%= checklist_evidence_tag(response) %>
                  </div>
                <% elsif response&.notes.present? %>
                  <p class="meta"><%= response.notes %></p>
                <% else %>
                  <p class="meta">-</p>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="panel">
    <h2><%= t("communications.notifications") %></h2>
    <% if @notifications.any? %>
      <ul class="notif-list">
        <% @notifications.each do |log| %>
          <li>
            <strong><%= log.channel %></strong>
            <% if log.phone.present? %> · <%= log.phone %><% end %>
            · <%= log.user&.name %> · <%= log.status %>
            <pre><%= log.message %></pre>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty"><%= t("communications.notifications_empty") %></p>
    <% end %>
  </section>
<% else %>
  <section class="panel">
    <h2><%= t("communications.send") %></h2>
    <%= form_with url: send_checklist_checklist_path(@checklist), method: :post, local: true do %>
      <%= render "communications/targets", units: @target_units, selected_ids: Array(params[:org_unit_ids]), embedded: true %>
      <div class="actions">
        <button class="btn" type="submit"><%= t("communications.send") %></button>
      </div>
    <% end %>
  </section>
<% end %>
