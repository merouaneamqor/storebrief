<% content_for :title, "#{t('inbox.title')} · Vazivo" %>

<h1><%= t("inbox.title") %></h1>
<p class="lede"><%= t("inbox.lede", store: @store.name) %></p>

<section class="panel">
  <% if @deliveries.any? %>
    <ul class="list">
      <% @deliveries.each do |delivery| %>
        <li>
          <div>
            <%= link_to delivery.communication.title, inbox_path(delivery) %>
            <div class="meta">
              <%= localized_badge(delivery.communication.format) %>
              <%= priority_badge(delivery.communication.priority) %>
              <% if delivery.dependency_blocked? %>
                <span class="badge"><%= t("morocco.dependency.blocked_badge") %></span>
              <% else %>
                <%= localized_badge(delivery.status) %>
              <% end %>
              <% if !delivery.communication.task? && !delivery.read_by?(current_user) %>
                <span class="badge"><%= t("morocco.read_receipts.unread_badge") %></span>
              <% elsif !delivery.communication.task? && delivery.read_by?(current_user) %>
                <span class="badge"><%= t("morocco.read_receipts.read_badge") %></span>
              <% end %>
            </div>
            <% if delivery.dependency_blocked? %>
              <p class="meta"><%= delivery.dependency_blocked_reason %></p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", icon: "inbox", text: t("inbox.empty") %>
  <% end %>
</section>
