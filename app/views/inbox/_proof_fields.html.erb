<%= hidden_field_tag :task_snapshot, Rails.application.message_verifier(:offline_task).generate([delivery.id, delivery.updated_at.iso8601(6), delivery.communication.updated_at.iso8601(6)]) %>
<% proof_types = tenant_feature?(:morocco_ops) ? Delivery::PROOF_FILE_TYPES : Delivery::PROOF_FILE_TYPES - Delivery::PROOF_VIDEO_TYPES %>
<fieldset class="task-proof-upload" data-max-bytes="<%= Delivery::PROOF_MAX_BYTES %>"
          data-video-max-bytes="<%= Delivery::PROOF_VIDEO_MAX_BYTES %>"
          data-max-count="<%= Delivery::PROOF_MAX_COUNT %>"
          data-types="<%= proof_types.join(',') %>"
          data-validation-error="<%= t(tenant_feature?(:morocco_ops) ? 'task_media.limits' : 'task_proof.limits') %>"
          data-queued="<%= t('task_proof.queued') %>"
          data-error="<%= t('task_proof.sync_error') %>">
  <legend><%= t("task_proof.title") %></legend>
  <p class="meta"><%= t(tenant_feature?(:morocco_ops) ? "task_media.limits" : "task_proof.limits") %></p>
  <p class="meta"><%= t("task_proof.required_hint") if delivery.communication.requires_proof? %></p>
  <label>
    <span><%= t("task_proof.choose_files") %></span>
    <input type="file" name="proof_files[]" multiple accept="<%= proof_types.join(',') %>">
  </label>
  <ul class="task-proof-selected" aria-live="polite"></ul>
  <p class="task-proof-upload__status meta" role="status"></p>
<div class="proof-pair" x-data="{
  beforeUrl: null,
  afterUrl: null,
  preview(event, key) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    if (key === 'before') { if (this.beforeUrl) URL.revokeObjectURL(this.beforeUrl); this.beforeUrl = url; }
    else { if (this.afterUrl) URL.revokeObjectURL(this.afterUrl); this.afterUrl = url; }
  }
}">
  <label class="proof-zone">
    <span class="proof-zone__label">
      <%= icon("camera", css_class: "icon icon--lg") %>
      <%= t("morocco.proof.before") %>
      <span class="proof-zone__hint"><%= t("morocco.proof.tap") %></span>
    </span>
    <% if delivery.photo_before.attached? %>
      <%= image_tag delivery.photo_before, class: "proof-zone__preview" %>
    <% end %>
    <template x-if="beforeUrl">
      <img :src="beforeUrl" alt="" class="proof-zone__preview">
    </template>
    <input class="proof-zone__input" type="file" name="photo_before" accept="image/*" capture="environment" @change="preview($event, 'before')">
  </label>
  <label class="proof-zone">
    <span class="proof-zone__label">
      <%= icon("camera", css_class: "icon icon--lg") %>
      <%= t("morocco.proof.after") %>
      <span class="proof-zone__hint"><%= t("morocco.proof.tap") %></span>
    </span>
    <% if delivery.photo_after.attached? %>
      <%= image_tag delivery.photo_after, class: "proof-zone__preview" %>
    <% end %>
    <template x-if="afterUrl">
      <img :src="afterUrl" alt="" class="proof-zone__preview">
    </template>
    <input class="proof-zone__input" type="file" name="photo_after" accept="image/*" capture="environment" @change="preview($event, 'after')">
  </label>
</div>
</fieldset>
