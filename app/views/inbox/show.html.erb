<% content_for :title, "#{@communication.title} · Inbox" %>

<p class="meta"><%= link_to t("inbox.back"), inbox_index_path %></p>
<h1><%= @communication.title %></h1>
<p class="lede">
  <%= localized_badge(@communication.format) %>
  <%= localized_badge(@delivery.status) %>
</p>

<section class="panel">
  <div class="prose"><%= @communication.body %></div>
</section>

<% if @delivery.pending? %>
  <div class="actions">
    <%= button_to(
          @communication.task? ? t("inbox.mark_complete") : t("inbox.mark_read"),
          complete_inbox_path(@delivery),
          method: :post,
          class: "btn"
        ) %>
  </div>
<% end %>
