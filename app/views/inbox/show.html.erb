<% content_for :title, "#{@communication.title} · Inbox" %>

<p class="meta"><%= link_to "← Inbox", inbox_index_path %></p>
<h1><%= @communication.title %></h1>
<p class="lede">
  <span class="badge badge--<%= @communication.format %>"><%= @communication.format %></span>
  <span class="badge badge--<%= @delivery.status %>"><%= @delivery.status %></span>
  · <%= @communication.created_at.strftime("%d %b %Y") %>
</p>

<section class="panel">
  <div class="prose"><%= @communication.body %></div>
</section>

<% if @delivery.pending? %>
  <div class="actions">
    <%= button_to(
          @communication.task? ? "Mark task complete" : "Mark as read",
          complete_inbox_path(@delivery),
          method: :post,
          class: "btn"
        ) %>
  </div>
<% end %>
