<% content_for :title, "#{t('reports.title')} · #{current_tenant.display_brand_name}" %>
<% content_for :head do %>
  <%= javascript_include_tag "chart.umd" %>
<% end %>

<h1><%= t("reports.title") %></h1>
<p class="lede"><%= t("reports.lede", tenant: current_tenant.name) %></p>

<div class="stats stats--4">
  <div class="stat stat--warn">
    <strong><%= @summary[:behind] %></strong>
    <span><%= t("reports.stores_behind") %></span>
  </div>
  <div class="stat stat--ok">
    <strong><%= @summary[:clear] %></strong>
    <span><%= t("reports.stores_clear") %></span>
  </div>
  <div class="stat">
    <strong><%= @summary[:brief_percent] %>%</strong>
    <span><%= t("reports.brief_rate") %></span>
    <div class="progress" role="progressbar" aria-valuenow="<%= @summary[:brief_percent] %>" aria-valuemin="0" aria-valuemax="100">
      <span class="progress__bar" style="width: <%= @summary[:brief_percent] %>%"></span>
    </div>
  </div>
  <div class="stat">
    <strong><%= @summary[:checklist_percent] %>%</strong>
    <span><%= t("reports.checklist_rate") %></span>
    <div class="progress" role="progressbar" aria-valuenow="<%= @summary[:checklist_percent] %>" aria-valuemin="0" aria-valuemax="100">
      <span class="progress__bar progress__bar--secondary" style="width: <%= @summary[:checklist_percent] %>%"></span>
    </div>
  </div>
</div>

<section class="report-charts panel"
         data-controller="reports-charts"
         data-reports-charts-stores-value="<%= [@summary[:clear], @summary[:behind]].to_json %>"
         data-reports-charts-workload-value="<%= { names: @store_rows.map { |row| row[:store].name }, briefs: @store_rows.map { |row| row[:briefs] }, checks: @store_rows.map { |row| row[:checks] } }.to_json %>"
         data-reports-charts-labels-value="<%= { clear: t('reports.stores_clear'), behind: t('reports.stores_behind'), briefs: t('reports.open_briefs'), checks: t('reports.open_checklists') }.to_json %>">
  <div class="report-chart report-chart--donut">
    <h2><%= t("reports.stores_split") %></h2>
    <canvas data-reports-charts-target="stores"></canvas>
  </div>
  <div class="report-chart">
    <h2><%= t("reports.workload") %></h2>
    <canvas data-reports-charts-target="workload"></canvas>
  </div>
</section>

<section class="panel">
  <h2><%= t("reports.by_store") %></h2>
  <% if @store_rows.any? %>
    <div class="table-scroll">
    <table class="report-table">
      <thead>
        <tr>
          <th><%= t("common.store") %></th>
          <th class="num"><%= t("reports.open_briefs") %></th>
          <th class="num"><%= t("reports.open_checklists") %></th>
          <th><%= t("reports.status") %></th>
        </tr>
      </thead>
      <tbody>
        <% @store_rows.each do |row| %>
          <tr class="<%= "is-behind" if row[:pending].positive? %>">
            <td><%= row[:store].name %></td>
            <td class="num"><%= row[:briefs] %></td>
            <td class="num"><%= row[:checks] %></td>
            <td>
              <% if row[:pending].zero? %>
                <span class="badge badge--completed"><%= t("reports.clear") %></span>
              <% else %>
                <span class="badge badge--pending"><%= t("reports.behind", count: row[:pending]) %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <p class="empty"><%= t("reports.no_stores") %></p>
  <% end %>
</section>

<div class="report-split">
<section class="panel">
  <h2><%= t("reports.oldest_briefs") %></h2>
  <% if @open_briefs.any? %>
    <ul class="list">
      <% @open_briefs.each do |delivery| %>
        <li>
          <div>
            <%= link_to delivery.communication.title, delivery.communication %>
            <div class="meta"><%= delivery.org_unit.name %> · <%= l(delivery.created_at, format: :short) %></div>
          </div>
          <%= localized_badge(delivery.status) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t("reports.briefs_clear") %></p>
  <% end %>
</section>

<section class="panel">
  <h2><%= t("reports.oldest_checklists") %></h2>
  <% if @open_checklists.any? %>
    <ul class="list">
      <% @open_checklists.each do |delivery| %>
        <li>
          <div>
            <%= link_to delivery.checklist.title, delivery.checklist %>
            <div class="meta"><%= delivery.org_unit.name %> · <%= l(delivery.created_at, format: :short) %></div>
          </div>
          <%= localized_badge(delivery.status) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t("reports.checklists_clear") %></p>
  <% end %>
</section>
</div>
