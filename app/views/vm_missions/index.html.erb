<% content_for :title, "#{t('morocco.vm_missions.title')} · Vazivo" %>

<header class="radar-head">
  <div>
    <p class="meta"><%= link_to t("communications.back_today"), app_root_path %></p>
    <h1><%= t("morocco.vm_missions.title") %></h1>
    <p class="meta"><%= t("morocco.vm_missions.lede") %></p>
  </div>
  <div class="radar-head__actions">
    <%= link_to new_vm_mission_path, class: "btn btn--quiet" do %>
      <%= icon("plus", css_class: "icon") %> <%= t("morocco.vm_missions.new") %>
    <% end %>
  </div>
</header>

<nav class="report-chips" aria-label="<%= t('morocco.vm_missions.filter') %>">
  <%= link_to t("morocco.vm_missions.all"), vm_missions_path, class: "report-chip #{'is-active' if @status.nil?}" %>
  <% VmMission::STATUSES.each do |status| %>
    <%= link_to t("morocco.vm_missions.statuses.#{status}"), vm_missions_path(status: status), class: "report-chip #{'is-active' if @status == status}" %>
  <% end %>
</nav>

<section class="panel">
  <% if @missions.any? %>
    <table class="report-table visits-table">
      <thead>
        <tr>
          <th><%= t("morocco.vm_missions.fields.title") %></th>
          <th><%= t("morocco.vm_missions.fields.deadline") %></th>
          <th><%= t("morocco.vm_missions.fields.stores") %></th>
          <th><%= t("morocco.vm_missions.fields.status") %></th>
          <th><span class="visually-hidden"><%= t("morocco.vm_missions.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @missions.each do |mission| %>
          <tr id="<%= dom_id(mission) %>" class="<%= 'is-stale' if mission.closed? %>">
            <td><%= link_to mission.title, vm_mission_path(mission) %></td>
            <td>
              <%= l(mission.deadline_on, format: :long) %>
              <% if mission.overdue? %>
                <span class="meta"><%= t("morocco.vm_missions.overdue") %></span>
              <% end %>
            </td>
            <td><%= t("morocco.vm_missions.stores_count", count: mission.org_units.size) %></td>
            <td><%= t("morocco.vm_missions.statuses.#{mission.status}") %></td>
            <td class="visits-table__tools">
              <%= link_to t("morocco.vm_missions.edit"), edit_vm_mission_path(mission), class: "btn btn--quiet" %>
              <%= button_to t("morocco.vm_missions.delete"),
                    vm_mission_path(mission),
                    method: :delete,
                    class: "btn btn--ghost",
                    form: { data: { turbo_confirm: t("morocco.vm_missions.delete_confirm") } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="meta"><%= t("morocco.vm_missions.empty") %></p>
  <% end %>
</section>
