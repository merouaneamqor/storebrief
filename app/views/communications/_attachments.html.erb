<% if communication.attachments? %>
  <section class="panel brief-attachments">
    <p class="section-title"><%= t("communications.attachments") %></p>
    <ul class="list">
      <% communication.attachments.each do |file| %>
        <li>
          <% if file.content_type.to_s.start_with?("image/") %>
            <%= image_tag url_for(file), alt: file.filename.to_s, class: "brief-attachments__image" %>
          <% end %>
          <div>
            <%= link_to file.filename, rails_blob_path(file, disposition: "attachment") %>
            <div class="meta">
              <%= t("communications.attachment_kind.#{file.content_type.to_s.start_with?('image/') ? 'photo' : 'pdf'}") %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
