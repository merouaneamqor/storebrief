<% content_for :title, "#{t('communications.new_title')} · StoreBrief" %>

<h1><%= t("communications.new_title") %></h1>
<p class="lede"><%= t("communications.new_lede", tenant: current_tenant.name) %></p>

<section class="panel" x-data="{ filter: '', type: 'all' }">
  <%= form_with model: @communication, class: "form-stack", local: true do |f| %>
    <% if @communication.errors.any? %>
      <div class="flash flash--alert"><%= @communication.errors.full_messages.to_sentence %></div>
    <% end %>

    <label>
      <%= t("communications.title_fr") %>
      <%= f.text_field :title_fr, required: true %>
    </label>
    <label>
      <%= t("communications.title_ar") %>
      <%= f.text_field :title_ar %>
    </label>
    <label>
      <%= t("communications.format") %>
      <%= f.select :format, Communication::FORMATS.map { |fmt| [t("common.#{fmt}"), fmt] } %>
    </label>
    <label>
      <%= t("communications.body_fr") %>
      <%= f.text_area :body_fr, required: true %>
    </label>
    <label>
      <%= t("communications.body_ar") %>
      <%= f.text_area :body_ar %>
    </label>

    <div>
      <strong><%= t("communications.targets") %></strong>
      <p class="meta"><%= t("communications.targets_help") %></p>
      <div class="filter-row">
        <input type="text" placeholder="<%= t('common.filter') %>" x-model="filter">
        <select x-model="type">
          <option value="all"><%= t("common.all") %></option>
          <option value="region"><%= t("common.region") %></option>
          <option value="store"><%= t("common.store") %></option>
        </select>
      </div>
      <div class="target-list">
        <% @target_units.each do |unit| %>
          <label
            x-show="(type === 'all' || type === '<%= unit.unit_type %>') && '<%= j unit.name.downcase %>'.includes(filter.toLowerCase())"
            x-cloak>
            <input type="checkbox" name="org_unit_ids[]" value="<%= unit.id %>">
            <span class="badge"><%= unit.unit_type %></span>
            <%= unit.name %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="actions">
      <%= f.submit t("communications.save_draft"), class: "btn btn--ghost", name: "commit", value: "draft" %>
      <%= f.submit t("communications.send"), class: "btn", name: "commit", value: "send" %>
    </div>
  <% end %>
</section>
