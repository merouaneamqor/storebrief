<% content_for :title, "Compose · StoreBrief" %>

<h1>Compose brief</h1>
<p class="lede">Send news or a task to selected stores in <%= current_tenant.name %>.</p>

<section class="panel" x-data="{ filter: '', type: 'all' }">
  <%= form_with model: @communication, class: "form-stack", local: true do |f| %>
    <% if @communication.errors.any? %>
      <div class="flash flash--alert">
        <%= @communication.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <label>
      Title
      <%= f.text_field :title, required: true %>
    </label>

    <label>
      Format
      <%= f.select :format, Communication::FORMATS.map { |fmt| [fmt.titleize, fmt] } %>
    </label>

    <label>
      Body
      <%= f.text_area :body, required: true %>
    </label>

    <div>
      <strong>Targets</strong>
      <p class="meta">Select regions and/or stores. Regions expand to all descendant stores.</p>
      <div class="filter-row">
        <input type="text" placeholder="Filter targets…" x-model="filter">
        <select x-model="type">
          <option value="all">All</option>
          <option value="region">Regions</option>
          <option value="store">Stores</option>
        </select>
      </div>
      <div class="target-list">
        <% @target_units.each do |unit| %>
          <label
            x-show="(type === 'all' || type === '<%= unit.unit_type %>') && '<%= j unit.name.downcase %>'.includes(filter.toLowerCase())"
            x-cloak>
            <input type="checkbox" name="org_unit_ids[]" value="<%= unit.id %>">
            <span class="badge"><%= unit.unit_type %></span>
            <%= unit.name %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="actions">
      <%= f.submit "Save draft", class: "btn btn--ghost", name: "commit", value: "Save draft" %>
      <%= f.submit "Send", class: "btn", name: "commit", value: "Send" %>
    </div>
  <% end %>
</section>

<style>[x-cloak]{display:none!important;}</style>
