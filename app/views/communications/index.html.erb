<% content_for :title, "#{t('communications.title')} · Vazivo" %>

<header class="radar-head">
  <div>
    <h1><%= t("communications.title") %></h1>
    <p class="lede"><%= t("communications.lede", tenant: current_tenant.name) %></p>
  </div>
  <% if hq_user? %>
    <div class="radar-head__actions">
      <%= link_to t("task_templates.title"), task_templates_path, class: "btn btn--ghost" %>
      <%= link_to t("communications.compose"), new_communication_path, class: "btn btn--primary" %>
    </div>
  <% end %>
</header>

<section class="panel">
  <% if @communications.any? %>
    <ul class="list">
      <% @communications.each do |brief| %>
        <li>
          <div>
            <%= link_to brief.title, brief %>
            <div class="meta">
              <%= localized_badge(brief.format) %>
              <%= priority_badge(brief.priority) %>
              <%= localized_badge(brief.status) %>
              <% if brief.review_pending? %><span class="badge badge--improve"><%= t("approval.statuses.pending_review") %></span><% end %>
              · <%= t("common.by") %> <%= brief.author.name %>
            </div>
          </div>
          <% if brief.sent? %>
            <%= render "shared/progress", stats: brief.completion_stats %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", icon: "inbox", text: t("communications.empty"),
                   action_label: (hq_user? ? t("communications.compose") : nil),
                   action_path: (hq_user? ? new_communication_path : nil) %>
  <% end %>
</section>
