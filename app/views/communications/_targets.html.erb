<% selected_ids = local_assigns.fetch(:selected_ids, []) %>
<% embedded = local_assigns.fetch(:embedded, false) %>
<% preview_url = local_assigns.fetch(:preview_url, preview_targets_communications_path(format: :json)) %>
<% stores = units.select(&:store?) %>
<% format_options = stores.map(&:store_format).compact_blank.uniq.sort %>
<% cluster_options = stores.map(&:cluster_key).compact_blank.uniq.sort %>
<% payload = units.map { |unit| { id: unit.id.to_s, name: unit.name, type: unit.unit_type, typeLabel: t("common.#{unit.unit_type}"), storeFormat: unit.store_format.to_s, cluster: unit.cluster_key.to_s } } %>
<section class="<%= embedded ? 'brief-targets-block' : 'brief-card' %>"
         x-data="briefTargets()"
         data-units="<%= h(payload.to_json) %>"
         data-selected="<%= h(selected_ids.map(&:to_s).to_json) %>"
         data-count-label="<%= t('communications.selected_count', count: '%{count}') %>"
         data-preview-url="<%= preview_url %>"
         data-preview-empty="<%= t('communications.assignment_preview_empty') %>">
  <% unless embedded %>
    <h2><%= t("communications.targets") %></h2>
  <% else %>
    <h3><%= t("communications.targets") %></h3>
  <% end %>
  <p class="meta"><%= t("communications.targets_help") %></p>

  <template x-for="id in selected" :key="'picked-' + id">
    <input type="hidden" name="org_unit_ids[]" :value="id">
  </template>
  <input type="hidden" name="assignment_role" :value="role">
  <input type="hidden" name="store_format" :value="storeFormat">
  <input type="hidden" name="cluster" :value="cluster">

  <div class="brief-chips" x-show="chosen.length" x-cloak>
    <template x-for="unit in chosen" :key="'chip-' + unit.id">
      <button type="button" class="brief-chip" @click="toggle(unit.id)">
        <span x-text="unit.name"></span>
        <span aria-hidden="true">×</span>
      </button>
    </template>
  </div>

  <div class="brief-target-tools">
    <input type="search" class="brief-search" placeholder="<%= t('common.filter') %>" x-model="filter" aria-label="<%= t('common.filter') %>">
    <select class="brief-type" x-model="type" aria-label="<%= t('communications.filter_type') %>">
      <option value="all"><%= t("common.all") %></option>
      <option value="region"><%= t("common.region") %></option>
      <option value="area"><%= t("common.area") %></option>
      <option value="store"><%= t("common.store") %></option>
    </select>
  </div>

  <div class="brief-target-tools brief-target-tools--filters">
    <select class="brief-type" x-model="role" aria-label="<%= t('communications.filter_role') %>">
      <option value=""><%= t("communications.filter_role_all") %></option>
      <% Membership::ROLES.each do |role_key| %>
        <option value="<%= role_key %>"><%= t("common.roles.#{role_key}") %></option>
      <% end %>
    </select>
    <select class="brief-type" x-model="storeFormat" aria-label="<%= t('communications.filter_format') %>">
      <option value=""><%= t("communications.filter_format_all") %></option>
      <% format_options.each do |format| %>
        <option value="<%= format %>"><%= format %></option>
      <% end %>
    </select>
    <select class="brief-type" x-model="cluster" aria-label="<%= t('communications.filter_cluster') %>">
      <option value=""><%= t("communications.filter_cluster_all") %></option>
      <% cluster_options.each do |cluster| %>
        <option value="<%= cluster %>"><%= cluster %></option>
      <% end %>
    </select>
  </div>

  <div class="brief-target-actions">
    <p class="brief-count" x-text="countLabel"></p>
    <button type="button" class="btn btn--ghost" @click="selectVisible()"><%= t("communications.select_visible") %></button>
    <button type="button" class="btn btn--ghost" @click="clear()"><%= t("communications.clear_selection") %></button>
  </div>

  <div class="brief-targets">
    <template x-for="unit in visible" :key="unit.id">
      <label class="brief-target">
        <input type="checkbox" :value="unit.id" x-model="selected">
        <span class="badge" x-text="unit.typeLabel"></span>
        <span x-text="unit.name"></span>
        <span class="meta" x-show="unit.storeFormat" x-text="unit.storeFormat"></span>
        <span class="meta" x-show="unit.cluster" x-text="unit.cluster"></span>
      </label>
    </template>
    <p class="empty" x-show="visible.length === 0" x-cloak><%= t("communications.no_matches") %></p>
  </div>

  <div class="brief-assignment-preview" aria-live="polite">
    <p class="brief-count" x-text="previewSummary"></p>
    <ul class="brief-assignment-preview__list" x-show="previewStores.length" x-cloak>
      <template x-for="store in previewStores" :key="'preview-' + store.id">
        <li>
          <strong x-text="store.name"></strong>
          <span class="meta" x-show="store.store_format" x-text="store.store_format"></span>
          <span class="meta" x-show="store.cluster" x-text="store.cluster"></span>
        </li>
      </template>
    </ul>
  </div>
</section>
