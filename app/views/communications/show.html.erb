<% content_for :title, "#{@communication.title} · Vazivo" %>
<% morocco = tenant_feature?(:morocco_ops) %>
<% pending_count = @deliveries.count(&:pending?) %>
<% reviewable_store_ids = morocco && !super_admin? ? current_user.permitted_store_ids(:verdicts, :escalate) : [] %>
<% rollup = morocco ? Delivery.awareness_rollup(@deliveries) : nil %>
<% received = rollup ? (rollup["received"] || rollup[:received] || 0) : 0 %>

<header class="radar-head">
  <div>
    <p class="meta"><%= link_to t("communications.back_today"), app_root_path %></p>
    <h1><%= @communication.title %></h1>
    <p class="meta">
      <%= localized_badge(@communication.format) %>
      <%= priority_badge(@communication.priority) %>
      <%= localized_badge(@communication.status) %>
      · <%= t("common.by") %> <%= @communication.author.name %>
    </p>
    <% if @communication.task? && hq_user? %>
      <%= form_with model: @communication, url: priority_communication_path(@communication), method: :patch,
                    class: "priority-form" do |f| %>
        <%= f.label :priority, t("communications.priority") %>
        <%= f.select :priority,
              Communication::PRIORITIES.map { |key| [ t("common.priorities.#{key}"), key ] },
              {}, onchange: "this.form.requestSubmit()" %>
        <noscript><%= f.submit t("communications.priority_save"), class: "btn btn--ghost" %></noscript>
      <% end %>
    <% end %>
    <% if hq_user? %>
      <div class="template-card__actions" style="margin-top:0.75rem;">
        <%= button_to t("task_templates.save_as"), save_as_template_communication_path(@communication),
              method: :post, class: "btn btn--ghost" %>
        <%= link_to t("task_templates.title"), task_templates_path, class: "btn btn--ghost" %>
      </div>
    <% end %>
  </div>
</header>

<%= render "shared/spreadsheet_downloads" %>

<% if @communication.body.present? %>
  <section class="panel brief-body">
    <div class="prose"><%= @communication.body %></div>
  </section>
<% end %>

<%= render "attachments", communication: @communication %>

<% if @communication.depends_on_another? %>
  <section class="panel">
    <p class="section-title"><%= t("morocco.dependency.title") %></p>
    <p>
      <%= t("morocco.dependency.waits_for") %>
      <%= link_to @communication.depends_on_communication.title, communication_path(@communication.depends_on_communication) %>
    </p>
    <% if hq_user? %>
      <%= button_to t("morocco.dependency.clear_task"), clear_dependency_communication_path(@communication),
            method: :post, class: "btn btn--ghost",
            data: { turbo_confirm: t("morocco.dependency.clear_task_confirm") } %>
    <% end %>
  </section>
<% end %>

<% if morocco && @communication.corrective? %>
  <section class="panel">
    <p class="section-title"><%= t("morocco.corrective.source_title") %></p>
    <ul class="list">
      <% if @communication.visit.present? %>
        <li>
          <span class="meta"><%= t("morocco.corrective.linked_visit") %></span>
          <%= link_to @communication.visit.org_unit.name, visit_path(@communication.visit) %>
          <span class="meta">· <%= l(@communication.visit.planned_at, format: :short) %></span>
        </li>
      <% end %>
      <% if @communication.source_delivery.present? %>
        <li>
          <span class="meta"><%= t("morocco.corrective.linked_audit") %></span>
          <%= link_to @communication.source_delivery.communication.title,
                communication_path(@communication.source_delivery.communication) %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @communication.questions? %>
  <section class="panel">
    <p class="section-title"><%= t("communications.questions") %></p>
    <ol class="brief-question-list">
      <% @communication.communication_questions.each do |question| %>
        <li>
          <strong>
            <%= question.title %>
            <% if question.required? %><span class="brief-required-mark">*</span><% end %>
          </strong>
          <div class="meta"><%= t("communications.question_types.#{question.question_type}") %></div>
          <% if question.choice? %>
            <ul class="brief-preview__choices">
              <% question.option_labels.each do |label| %>
                <li><%= label %></li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>

<% if @communication.recurring? || @communication.occurrence? %>
  <% source = @communication.series_source %>
  <section class="panel brief-recurrence-card">
    <p class="section-title"><%= t("communications.recurrence.title") %></p>
    <% if @communication.occurrence? %>
      <p class="meta">
        <%= t("communications.recurrence.occurrence_of", date: l(@communication.occurrence_on, format: :long)) %>
        · <%= link_to t("communications.recurrence.series_source"), communication_path(source) %>
      </p>
    <% else %>
      <p><strong><%= recurrence_summary(@communication.recurrence_rule) %></strong></p>
      <p class="meta">
        <% if @communication.recurrence_active? %>
          <%= t("communications.recurrence.next_on", date: l(@communication.recurrence_next_on, format: :long)) %>
        <% else %>
          <%= t("communications.recurrence.ended") %>
        <% end %>
        · <%= t("communications.recurrence.occurrences_count", count: @communication.occurrences.count) %>
      </p>
      <% if @communication.recurrence_active? %>
        <%= button_to t("communications.recurrence.stop"), stop_recurrence_communication_path(@communication),
              method: :post, class: "btn btn--ghost",
              data: { turbo_confirm: t("communications.recurrence.stop_confirm") } %>
      <% end %>
    <% end %>
  </section>
<% end %>

<section class="panel brief-progress-card">
  <p class="section-title"><%= t("communications.delivery") %></p>
  <% if morocco && rollup %>
    <p class="brief-progress-card__summary">
      <%= t("morocco.hq.received_line", done: received, total: rollup[:total]) %>
      · <%= t("communications.of_complete", done: @stats[:done], total: @stats[:total], pending: pending_count) %>
    </p>
    <%= render "shared/awareness_progress", rollup: rollup %>
  <% else %>
    <%= render "shared/progress", stats: @stats %>
  <% end %>
  <% if @read_receipts && @read_receipts[:total].positive? %>
    <p class="brief-progress-card__summary meta" data-testid="hq-unread-count">
      <%= t("morocco.read_receipts.hq_unread_line",
            unread: @read_receipts[:unread],
            read: @read_receipts[:read],
            total: @read_receipts[:total]) %>
    </p>
  <% end %>

  <% if hq_user? && pending_count.positive? && current_tenant.feature?(:push_alerts) %>
    <div class="hq-push-remind">
      <%= button_to notify_push_communication_path(@communication),
            method: :post,
            class: "btn",
            data: { turbo_confirm: t("communications.notify_push_confirm", count: pending_count) } do %>
        <%= icon("send", css_class: "icon") %>
        <%= t("communications.notify_push") %>
      <% end %>
      <p class="meta"><%= t("communications.notify_push_hint", count: pending_count) %></p>
    </div>
  <% end %>
</section>

<section class="panel">
  <p class="section-title"><%= t("communications.stores") %></p>
  <% if @deliveries.any? %>
    <ul class="store-track">
      <% @deliveries.each do |delivery| %>
        <% can_review_delivery = super_admin? || reviewable_store_ids.include?(delivery.org_unit_id) %>
        <% needs_coach = delivery.finished? || delivery.verdict.present? || delivery.pending_approval? %>
        <li id="store-<%= delivery.org_unit_id %>" class="store-track__item">
          <div class="store-track__head">
            <div class="store-track__main">
              <strong class="store-track__name"><%= delivery.org_unit.name %></strong>
              <% if morocco && @communication.acknowledgement_required? %>
                <p class="meta">
                  <%= t(delivery.acknowledged_at? ? "broadcasts.acknowledged" : "broadcasts.pending_ack") %>
                  <% if delivery.acknowledged_at? %> · <%= l(delivery.acknowledged_at, format: :short) %><% end %>
                </p>
              <% end %>
              <div class="meta">
                <% if morocco %>
                  <%= delivery.assignee&.name || t("morocco.owner.unassigned") %>
                  · <%= icon("clock", css_class: "icon icon--sm") %> <%= morocco_due_label(delivery.due_at) || "-" %>
                  · <%= t("morocco.awareness.steps.#{delivery.awareness}", default: t("common.pending")) %>
                  <% if delivery.escalation_level.to_i.positive? %>
                    · <%= icon("alert-triangle", css_class: "icon icon--sm") %> <%= t("morocco.escalation.level_#{delivery.escalation_level}") %>
                  <% end %>
                <% else %>
                  <%= localized_badge(delivery.status) %>
                <% end %>
                <% receipts = delivery.read_receipt_counts %>
                <% if receipts[:total].positive? %>
                  · <%= t("morocco.read_receipts.store_unread",
                        unread: receipts[:unread],
                        read: receipts[:read],
                        total: receipts[:total]) %>
                <% end %>
              </div>
            </div>
            <% if morocco %>
              <span class="tone tone--<%= delivery.tone %>"><%= tone_icon(delivery.tone) %> <%= t("morocco.tone.#{delivery.tone}") %></span>
            <% end %>
          </div>

          <%= render "inbox/proof_gallery", delivery: delivery %>

          <% if @communication.questions? && delivery.delivery_answers.any? %>
            <div class="brief-answers">
              <% delivery.delivery_answers.sort_by { |answer| answer.communication_question.position }.each do |answer| %>
                <div class="brief-answers__row">
                  <span class="meta"><%= answer.communication_question.title %></span>
                  <% if answer.communication_question.image? && answer.image.attached? %>
                    <%= image_tag answer.image, class: "thumb", alt: answer.communication_question.title %>
                  <% else %>
                    <strong><%= answer.display_value.presence || "-" %></strong>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if morocco && delivery.verdict == "non_conforme" %>
            <%= link_to t("tickets.new"), new_incident_ticket_path(source_type: "Delivery", source_id: delivery.id), class: "btn btn--sm" %>
          <% end %>
          <% if morocco && (delivery.verdict.present? || delivery.score.present?) %>
            <p class="verdict-chip <%= "verdict-chip--#{delivery.verdict}" if delivery.verdict.present? %>">
              <% if delivery.score.present? %>
                <strong><%= t("morocco.verdict.score", score: delivery.score) %></strong>
              <% end %>
              <% if delivery.verdict.present? %>
                <strong><%= t("morocco.verdict.#{delivery.verdict}") %></strong>
              <% end %>
              <% if delivery.verdict_note.present? %><span><%= delivery.verdict_note %></span><% end %>
            </p>
          <% end %>

          <% if morocco && delivery.delivery_events.any? %>
            <details class="delivery-timeline">
              <summary><%= t("morocco.history.title") %></summary>
              <ol class="delivery-timeline__list">
                <% delivery.delivery_events.sort_by(&:created_at).reverse_each do |event| %>
                  <li>
                    <span class="meta">
                      <%= event.created_at.in_time_zone(Vazivo::Schedule::ZONE).strftime("%d/%m %H:%M") %>
                      · <%= event.actor&.name || "-" %>
                    </span>
                    <strong><%= t("morocco.history.kinds.#{event.kind}") %></strong>
                    <span class="meta"><%= delivery_event_detail(event) %></span>
                  </li>
                <% end %>
              </ol>
            </details>
          <% end %>

          <% if delivery.dependency_blocked? %>
            <p class="flash flash--alert"><%= delivery.dependency_blocked_reason %></p>
          <% elsif delivery.dependency_cleared_at.present? && @communication.depends_on_another? %>
            <p class="meta"><%= t("morocco.dependency.cleared_for_store") %></p>
          <% end %>

          <% if hq_user? && @communication.depends_on_another? && delivery.pending? %>
            <div class="verdict-form verdict-form--compact">
              <% if delivery.dependency_blocked? %>
                <%= button_to t("morocco.dependency.clear_store"), delivery_clear_dependency_path(delivery),
                      method: :post, class: "btn btn--ghost" %>
              <% end %>
              <%= form_with url: delivery_reassign_path(delivery), method: :patch, class: "verdict-form verdict-form--compact" do %>
                <label class="meta" for="assignee_id_<%= delivery.id %>"><%= t("morocco.dependency.reassign") %></label>
                <select id="assignee_id_<%= delivery.id %>" name="assignee_id">
                  <option value=""><%= t("morocco.owner.unassigned") %></option>
                  <% delivery.org_unit.users.each do |user| %>
                    <option value="<%= user.id %>" <%= "selected" if delivery.assignee_id == user.id %>><%= user.name %></option>
                  <% end %>
                </select>
                <button type="submit" class="btn btn--ghost"><%= t("morocco.dependency.reassign_save") %></button>
              <% end %>
            </div>
          <% end %>

          <% if morocco %>
            <% if can_review_delivery %>
            <% if delivery.pending_approval? %>
              <%= form_with url: delivery_verdict_path(delivery), method: :post, class: "verdict-form verdict-form--compact" do %>
                <label class="meta" for="verdict_note_<%= delivery.id %>"><%= t("morocco.approval.decide") %></label>
                <p class="meta"><%= t("morocco.approval.decide_help") %></p>
                <textarea id="verdict_note_<%= delivery.id %>" name="verdict_note" rows="2" required placeholder="<%= t('morocco.verdict.note') %>"></textarea>
                <div class="verdict-form__actions">
                  <button type="submit" class="btn btn--primary" name="verdict" value="conforme">
                    <%= t("morocco.approval.approve_conforme") %>
                  </button>
                  <button type="submit" class="btn btn--ghost" name="verdict" value="improve">
                    <%= t("morocco.approval.approve_improve") %>
                  </button>
                  <button type="submit" class="btn btn--ghost" name="verdict" value="non_conforme">
                    <%= t("morocco.approval.reject") %>
                  </button>
                </div>
              <% end %>
            <% elsif needs_coach %>
              <%= form_with url: delivery_verdict_path(delivery), method: :post, class: "verdict-form verdict-form--compact" do %>
                <label class="meta" for="verdict_note_<%= delivery.id %>"><%= t("morocco.verdict.coach") %></label>
                <textarea id="verdict_note_<%= delivery.id %>" name="verdict_note" rows="2" placeholder="<%= t('morocco.verdict.note') %>"><%= delivery.verdict_note %></textarea>
                <div class="verdict-form__actions">
                  <% Delivery::VERDICTS.each do |verdict| %>
                    <button type="submit" class="btn <%= verdict == 'conforme' ? 'btn--primary' : 'btn--ghost' %>" name="verdict" value="<%= verdict %>">
                      <%= t("morocco.verdict.#{verdict}") %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <details class="store-track__coach">
                <summary><%= t("morocco.verdict.coach") %></summary>
                <%= form_with url: delivery_verdict_path(delivery), method: :post, class: "verdict-form verdict-form--compact" do %>
                  <textarea name="verdict_note" rows="2" placeholder="<%= t('morocco.verdict.note') %>"><%= delivery.verdict_note %></textarea>
                  <div class="verdict-form__actions">
                    <% Delivery::VERDICTS.each do |verdict| %>
                      <button type="submit" class="btn <%= verdict == 'conforme' ? 'btn--primary' : 'btn--ghost' %>" name="verdict" value="<%= verdict %>">
                        <%= t("morocco.verdict.#{verdict}") %>
                      </button>
                    <% end %>
                  </div>
                <% end %>
              </details>
            <% end %>

            <% end %>

            <% if Vazivo::CorrectiveAction.issue_verdict?(delivery.verdict) %>
              <% if delivery.corrective_communication.present? %>
                <p class="meta">
                  <%= t("morocco.corrective.exists") %>
                  <%= link_to delivery.corrective_communication.title, communication_path(delivery.corrective_communication) %>
                </p>
              <% elsif can_review_delivery %>
                <%= form_with url: delivery_corrective_action_path(delivery), method: :post, class: "verdict-form verdict-form--compact" do %>
                  <% visits = @store_visits&.[](delivery.org_unit_id) || [] %>
                  <% if visits.any? %>
                    <label class="meta" for="visit_id_<%= delivery.id %>"><%= t("morocco.corrective.link_visit") %></label>
                    <select id="visit_id_<%= delivery.id %>" name="visit_id">
                      <option value=""><%= t("morocco.corrective.no_visit") %></option>
                      <% visits.each do |visit| %>
                        <option value="<%= visit.id %>">
                          <%= l(visit.planned_at, format: :short) %> · <%= t("morocco.visits.statuses.#{visit.status}") %>
                        </option>
                      <% end %>
                    </select>
                  <% end %>
                  <button type="submit" class="btn btn--primary"><%= t("morocco.corrective.create") %></button>
                <% end %>
              <% end %>
            <% end %>

            <%= render "deliveries/comments",
                  delivery: delivery,
                  mentionable_users: @mentionable_users,
                  section_id: "delivery-comment-#{delivery.id}" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="empty">
      <%= icon("check-circle", css_class: "icon empty__icon") %>
      <p class="empty__text"><%= t("communications.stores_empty") %></p>
    </div>
  <% end %>
</section>

<% if @notifications.any? %>
  <details class="panel brief-alerts">
    <summary class="section-title"><%= t("communications.notifications") %> · <%= @notifications.size %></summary>
    <ul class="billing-log">
      <% @notifications.each do |log| %>
        <li>
          <div class="billing-log__main">
            <span class="billing-log__channel"><%= t("billing.channel_#{log.channel == 'web_push' ? 'push' : log.channel}", default: log.channel) %></span>
            <strong><%= log.message.to_s.truncate(120) %></strong>
            <span class="meta">
              <%= log.user&.name || log.phone || "-" %>
              · <%= log.status %>
              · <%= log.created_at.in_time_zone(Vazivo::Schedule::ZONE).strftime("%d/%m %H:%M") %>
            </span>
          </div>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>
