<% percent = stats[:percent].to_i %>
<div class="progress-wrap">
  <div class="progress" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= percent %>%">
    <span class="progress__bar" style="width: <%= percent %>%"></span>
  </div>
  <span class="meta"><%= stats[:done] %>/<%= stats[:total] %> · <%= percent %>%</span>
</div>
