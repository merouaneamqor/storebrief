<%= form_with url: request.path, method: :get, class: "report-toolbar" do |form| %>
  <%= form.label :from, t("report_period.from") %>
  <%= form.date_field :from, value: @date_range.from.iso8601, min: Reports::DateRange::EARLIEST_DATE.iso8601, max: Reports::DateRange::LATEST_DATE.iso8601 %>
  <%= form.label :to, t("report_period.to") %>
  <%= form.date_field :to, value: @date_range.to.iso8601, min: Reports::DateRange::EARLIEST_DATE.iso8601, max: Reports::DateRange::LATEST_DATE.iso8601 %>
  <% if local_assigns[:trends] %>
    <%= form.label :interval, t("report_period.interval") %>
    <%= form.select :interval, %w[week month].map { |key| [t("report_period.#{key}"), key] }, selected: @trends.interval %>
    <%= form.label :group_by, t("report_period.group_by") %>
    <%= form.select :group_by, %w[region area store].map { |key| [t("report_period.#{key}"), key] }, selected: @trends.group_by %>
  <% end %>
  <%= form.submit t("report_period.apply"), class: "btn btn--quiet" %>
<% end %>
