<% content_for :title, "#{t('landing.resources.title')} · StoreBrief" %>

<section class="m-section">
  <div class="m-narrow">
    <h1><%= t("landing.resources.title") %></h1>
    <p class="m-lede"><%= t("landing.footer.strategy_lede") %></p>
  </div>

  <article class="m-resource-card">
    <h2><%= t("landing.resources.strategy_title") %></h2>
    <p class="m-lede"><%= t("landing.resources.strategy_intro") %></p>

    <h3><%= t("landing.resources.pillars_title") %></h3>
    <ul class="m-resource-list">
      <li><%= t("landing.resources.pillar1") %></li>
      <li><%= t("landing.resources.pillar2") %></li>
      <li><%= t("landing.resources.pillar3") %></li>
      <li><%= t("landing.resources.pillar4") %></li>
    </ul>

    <h3><%= t("landing.resources.phases_title") %></h3>
    <ol class="m-resource-list m-resource-list--ordered">
      <li><%= t("landing.resources.phase1") %></li>
      <li><%= t("landing.resources.phase2") %></li>
      <li><%= t("landing.resources.phase3") %></li>
    </ol>

    <div class="m-hero__actions" style="margin-top:1.5rem;">
      <%= link_to t("landing.resources.download"), marketing_strategy_path, class: "m-btn" %>
      <a href="<%= root_path(anchor: 'demo') %>" class="m-btn m-btn--ghost"><%= t("landing.resources.cta") %></a>
    </div>
  </article>
</section>
