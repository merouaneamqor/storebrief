<% content_for :title, "#{t('landing.hero.brand')} · #{t('landing.hero.title')}" %>
<% title = t("landing.hero.title") %>
<% accent = t("landing.hero.accent") %>

<section class="m-hero">
  <div class="m-hero__copy">
    <p class="m-badge">
      <span class="m-mark" aria-hidden="true"></span>
      <%= t("landing.hero.kicker") %>
    </p>
    <h1>
      <% if accent.present? && title.include?(accent) %>
        <% before, after = title.split(accent, 2) %>
        <%= before %><span class="m-accent"><%= accent %></span><%= after %>
      <% else %>
        <%= title %>
      <% end %>
    </h1>
    <p class="m-lede"><%= t("landing.hero.lede") %></p>
    <div class="m-hero__actions">
      <a href="#demo" class="m-btn"><%= t("landing.hero.demo") %></a>
      <a href="#how" class="m-textlink">
        <%= t("landing.hero.explore") %>
        <span class="m-textlink__arrow" aria-hidden="true"></span>
      </a>
    </div>
  </div>

  <div class="m-stage">
    <p class="m-stage__caption"><%= t("landing.hero.example") %></p>
    <div class="m-window m-window--hq">
      <header>
        <span class="m-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <strong><%= t("landing.hero.scene_title") %></strong>
        <em><%= t("landing.hero.scene_status") %></em>
      </header>
      <div class="m-window__body">
        <ul class="m-stores">
          <li class="is-done">
            <span class="m-stores__name"><%= t("landing.hero.store_a") %></span>
            <span class="m-stores__state"><%= t("landing.hero.done") %></span>
          </li>
          <li class="is-done">
            <span class="m-stores__name"><%= t("landing.hero.store_b") %></span>
            <span class="m-stores__state"><%= t("landing.hero.done") %></span>
          </li>
          <li class="is-wait">
            <span class="m-stores__name"><%= t("landing.hero.store_c") %></span>
            <span class="m-stores__state"><%= t("landing.hero.waiting") %></span>
          </li>
        </ul>
      </div>
    </div>
    <div class="m-window m-window--store">
      <header>
        <span class="m-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <strong><%= t("landing.hero.phone_title") %></strong>
      </header>
      <div class="m-window__body">
        <div class="m-task done"><i aria-hidden="true"></i><span><%= t("landing.hero.task_done") %></span></div>
        <div class="m-task m-task--photo"><i aria-hidden="true"></i><span><%= t("landing.hero.task_photo") %></span><em><%= t("landing.hero.photo") %></em></div>
        <div class="m-task"><i aria-hidden="true"></i><span><%= t("landing.hero.task_open") %></span></div>
      </div>
    </div>
  </div>
</section>

<ul class="m-metrics">
  <li><%= t("landing.proof.a") %></li>
  <li><%= t("landing.proof.b") %></li>
  <li><%= t("landing.proof.c") %></li>
  <li><%= t("landing.proof.d") %></li>
</ul>

<section class="m-gap" id="problems">
  <div class="m-wrap">
    <header class="m-center">
      <h2><%= t("landing.problems.title") %></h2>
    </header>
    <div class="m-gap__grid">
      <article>
        <span>01</span>
        <h3><%= t("landing.problems.p1_title") %></h3>
        <p><%= t("landing.problems.p1_body") %></p>
      </article>
      <article>
        <span>02</span>
        <h3><%= t("landing.problems.p2_title") %></h3>
        <p><%= t("landing.problems.p2_body") %></p>
      </article>
      <article>
        <span>03</span>
        <h3><%= t("landing.problems.p3_title") %></h3>
        <p><%= t("landing.problems.p3_body") %></p>
      </article>
    </div>
  </div>
</section>

<section class="m-story">
  <div class="m-wrap">
    <h2><%= t("landing.trust.title") %></h2>
    <p><%= t("landing.trust.body") %></p>
  </div>
</section>

<section class="m-platform" id="how">
  <div class="m-wrap">
    <header class="m-center">
      <h2><%= t("landing.walkthrough.title") %></h2>
      <p class="m-lede"><%= t("landing.walkthrough.example") %></p>
    </header>
    <ol class="m-flow">
      <li>
        <span>1</span>
        <h3><%= t("landing.walkthrough.step1") %></h3>
        <p><%= t("landing.walkthrough.step1_body") %></p>
      </li>
      <li>
        <span>2</span>
        <h3><%= t("landing.walkthrough.step2") %></h3>
        <p><%= t("landing.walkthrough.step2_body") %></p>
      </li>
      <li>
        <span>3</span>
        <h3><%= t("landing.walkthrough.step3") %></h3>
        <p><%= t("landing.walkthrough.step3_body") %></p>
      </li>
      <li>
        <span>4</span>
        <h3><%= t("landing.walkthrough.step4") %></h3>
        <p><%= t("landing.walkthrough.step4_body") %></p>
      </li>
    </ol>
  </div>
</section>

<section class="m-show">
  <div class="m-wrap">
    <header class="m-center">
      <h2><%= t("landing.benefits.title") %></h2>
    </header>
    <div class="m-show__grid">
      <article class="m-showcard">
        <div class="m-art m-art--list" aria-hidden="true">
          <span class="is-on"></span>
          <span class="is-on"></span>
          <span></span>
        </div>
        <h3><%= t("landing.benefits.b1_title") %></h3>
        <p><%= t("landing.benefits.b1_body") %></p>
      </article>
      <article class="m-showcard">
        <div class="m-art m-art--photo" aria-hidden="true"><span></span></div>
        <h3><%= t("landing.benefits.b2_title") %></h3>
        <p><%= t("landing.benefits.b2_body") %></p>
      </article>
      <article class="m-showcard">
        <div class="m-art m-art--bars" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>
        <h3><%= t("landing.benefits.b3_title") %></h3>
        <p><%= t("landing.benefits.b3_body") %></p>
      </article>
    </div>
  </div>
</section>

<section class="m-roles" id="roles" x-data="{ role: 'store' }">
  <div class="m-wrap">
    <header class="m-center">
      <h2><%= t("landing.roles.title") %></h2>
    </header>
    <div class="m-roles__tabs" role="tablist">
      <button type="button" role="tab" id="role-tab-store" aria-controls="role-panel-store" :aria-selected="(role === 'store').toString()" :class="{ 'is-on': role === 'store' }" @click="role = 'store'"><%= t("landing.roles.store_title") %></button>
      <button type="button" role="tab" id="role-tab-region" aria-controls="role-panel-region" :aria-selected="(role === 'region').toString()" :class="{ 'is-on': role === 'region' }" @click="role = 'region'"><%= t("landing.roles.region_title") %></button>
      <button type="button" role="tab" id="role-tab-hq" aria-controls="role-panel-hq" :aria-selected="(role === 'hq').toString()" :class="{ 'is-on': role === 'hq' }" @click="role = 'hq'"><%= t("landing.roles.hq_title") %></button>
    </div>
    <div class="m-roles__stage">
      <article role="tabpanel" id="role-panel-store" aria-labelledby="role-tab-store" x-show="role === 'store'">
        <h3><%= t("landing.roles.store_title") %></h3>
        <p><%= t("landing.roles.store_body") %></p>
      </article>
      <article role="tabpanel" id="role-panel-region" aria-labelledby="role-tab-region" x-show="role === 'region'" x-cloak>
        <h3><%= t("landing.roles.region_title") %></h3>
        <p><%= t("landing.roles.region_body") %></p>
      </article>
      <article role="tabpanel" id="role-panel-hq" aria-labelledby="role-tab-hq" x-show="role === 'hq'" x-cloak>
        <h3><%= t("landing.roles.hq_title") %></h3>
        <p><%= t("landing.roles.hq_body") %></p>
      </article>
    </div>
  </div>
</section>

<section class="m-wrap m-block" id="fit">
  <header class="m-center">
    <h2><%= t("landing.fits.title") %></h2>
    <p class="m-lede"><%= t("landing.fits.lede") %></p>
  </header>
  <%= render "marketing/fits" %>
  <p class="m-fits__more"><%= link_to t("landing.fits.more"), resources_path %></p>
</section>

<section class="m-wrap m-block" id="faq">
  <header class="m-center">
    <h2><%= t("landing.faq.title") %></h2>
  </header>
  <div class="m-faq">
    <% (1..5).each do |n| %>
      <details>
        <summary><%= t("landing.faq.q#{n}") %></summary>
        <p><%= t("landing.faq.a#{n}") %></p>
      </details>
    <% end %>
  </div>
</section>

<section class="m-close" id="demo">
  <% if @demo_request.errors.any? %>
    <script>document.getElementById("demo")?.scrollIntoView({ block: "start" })</script>
  <% end %>
  <div class="m-close__inner">
    <div class="m-close__copy">
      <h2><%= t("landing.demo.title") %></h2>
      <p class="m-lede"><%= t("landing.demo.lede") %></p>
      <ul>
        <li><%= t("landing.demo.point1") %></li>
        <li><%= t("landing.demo.point2") %></li>
        <li><%= t("landing.demo.point3") %></li>
      </ul>
    </div>
    <%= form_with model: @demo_request, url: demo_requests_path, class: "m-form m-form--demo", local: true do |f| %>
      <% if @demo_request.errors.any? %>
        <p class="m-form__error" role="alert"><%= @demo_request.errors.full_messages.to_sentence %></p>
      <% end %>
      <% if @demo_request.requested_plan.present? %>
        <p class="m-form__plan"><span><%= t("pricing.form.selected_plan") %></span> <strong><%= t("pricing.plans.#{@demo_request.requested_plan}.name") %></strong></p>
      <% end %>

      <fieldset class="m-form__group">
        <legend><%= t("pricing.form.about_you") %></legend>
        <div class="m-form__row">
          <label>
            <%= t("landing.demo.name") %>
            <%= f.text_field :name, required: true, autocomplete: "name" %>
          </label>
          <label>
            <%= t("landing.demo.company") %>
            <%= f.text_field :company, required: true, autocomplete: "organization" %>
          </label>
        </div>
        <p class="m-hint" id="contact-hint"><%= t("landing.demo.contact_hint") %></p>
        <div class="m-form__row">
          <label>
            <%= t("landing.demo.email") %>
            <%= f.email_field :email, autocomplete: "email", aria: { describedby: "contact-hint" } %>
          </label>
          <label>
            <%= t("landing.demo.phone") %>
            <%= f.telephone_field :phone, autocomplete: "tel", aria: { describedby: "contact-hint" } %>
          </label>
        </div>
      </fieldset>

      <fieldset class="m-form__group">
        <legend><%= t("pricing.form.about_network") %></legend>
        <div class="m-form__row">
          <label>
            <%= t("landing.demo.stores") %>
            <%= f.number_field :store_count, min: 1, step: 1, inputmode: "numeric" %>
          </label>
          <label>
            <%= t("pricing.form.country") %>
            <%= f.text_field :country, autocomplete: "country-name", maxlength: 80 %>
          </label>
        </div>
        <div class="m-form__row">
          <label>
            <%= t("pricing.form.plan") %>
            <%= f.select :requested_plan, [[t("pricing.form.no_preference"), ""]] + DemoRequest.sellable_plan_keys.map { |k| [t("pricing.plans.#{k}.name"), k] } %>
          </label>
          <label>
            <%= t("landing.demo.language") %>
            <%= f.select :preferred_locale, User::LOCALES.map { |code| [t("locales.#{code}"), code] } %>
          </label>
        </div>
        <label>
          <%= t("pricing.form.requirements") %>
          <%= f.text_area :requirements, rows: 3, maxlength: 2000 %>
        </label>
      </fieldset>

      <div aria-hidden="true" style="position:absolute;left:-10000px">
        <label>Website <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %></label>
      </div>
      <label class="m-form__consent">
        <%= check_box_tag "demo_request[privacy_consent]", "1", false, required: true %>
        <span><%= t("landing.demo.privacy_consent", privacy_link: link_to(t("privacy.page.title"), legal_privacy_path, target: "_blank", rel: "noopener")).html_safe %></span>
      </label>
      <label class="m-form__consent">
        <%= check_box_tag "demo_request[marketing_contact_consent]", "1", false %>
        <span><%= t("landing.demo.marketing_consent") %></span>
      </label>
      <button type="submit" class="m-btn m-btn--block"><%= t("landing.demo.submit") %></button>
      <p class="m-reassure"><%= t("landing.demo.reassure") %></p>
    <% end %>
  </div>
</section>
