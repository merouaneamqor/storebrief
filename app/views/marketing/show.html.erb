<% content_for :title, "#{t('landing.hero.brand')} — #{t('landing.hero.title')}" %>

<section class="m-hero">
  <div class="m-hero__copy">
    <p class="m-kicker"><%= t("landing.hero.kicker") %></p>
    <h1><%= t("landing.hero.title") %></h1>
    <p class="m-lede"><%= t("landing.hero.lede") %></p>
    <div class="m-hero__actions">
      <a href="#demo" class="m-btn"><%= t("landing.hero.demo") %></a>
      <a href="#how" class="m-btn m-btn--ghost"><%= t("landing.hero.explore") %></a>
    </div>
    <ul class="m-proof">
      <li><%= t("landing.proof.a") %></li>
      <li><%= t("landing.proof.b") %></li>
      <li><%= t("landing.proof.c") %></li>
      <li><%= t("landing.proof.d") %></li>
    </ul>
  </div>

  <div class="m-stage" aria-hidden="true">
    <div class="m-window m-window--hq">
      <header>
        <span class="m-dots"><i></i><i></i><i></i></span>
        <strong><%= t("landing.hero.hq") %></strong>
        <em><%= t("landing.hero.live") %></em>
      </header>
      <div class="m-window__body">
        <div class="m-kpis">
          <div><b>24</b><span><%= t("landing.hero.kpi_stores") %></span></div>
          <div><b>18</b><span><%= t("landing.hero.kpi_done") %></span></div>
          <div><b>6</b><span><%= t("landing.hero.kpi_wait") %></span></div>
        </div>
        <ul class="m-rows">
          <li><span></span><em>72%</em></li>
          <li><span class="mid"></span><em>54%</em></li>
          <li><span class="short"></span><em>31%</em></li>
        </ul>
      </div>
    </div>
    <div class="m-window m-window--store">
      <header>
        <span class="m-dots"><i></i><i></i><i></i></span>
        <strong><%= t("landing.hero.store") %></strong>
      </header>
      <div class="m-window__body">
        <div class="m-task done"><i></i><span></span></div>
        <div class="m-task"><i></i><span></span></div>
        <div class="m-task"><i></i><span class="short"></span></div>
      </div>
    </div>
  </div>
</section>

<section class="m-band" id="solutions">
  <div class="m-wrap m-band__inner">
    <h2><%= t("landing.trust.title") %></h2>
    <p><%= t("landing.trust.body") %></p>
  </div>
</section>

<section class="m-wrap m-block">
  <header class="m-block__head">
    <h2><%= t("landing.problems.title") %></h2>
  </header>
  <div class="m-cards">
    <article class="m-card">
      <span class="m-index">01</span>
      <h3><%= t("landing.problems.p1_title") %></h3>
      <p><%= t("landing.problems.p1_body") %></p>
    </article>
    <article class="m-card">
      <span class="m-index">02</span>
      <h3><%= t("landing.problems.p2_title") %></h3>
      <p><%= t("landing.problems.p2_body") %></p>
    </article>
    <article class="m-card">
      <span class="m-index">03</span>
      <h3><%= t("landing.problems.p3_title") %></h3>
      <p><%= t("landing.problems.p3_body") %></p>
    </article>
  </div>
</section>

<section class="m-wrap m-block" id="how">
  <header class="m-block__head">
    <h2><%= t("landing.walkthrough.title") %></h2>
  </header>
  <ol class="m-flow">
    <li>
      <span>1</span>
      <h3><%= t("landing.walkthrough.step1") %></h3>
      <p><%= t("landing.walkthrough.step1_body") %></p>
    </li>
    <li>
      <span>2</span>
      <h3><%= t("landing.walkthrough.step2") %></h3>
      <p><%= t("landing.walkthrough.step2_body") %></p>
    </li>
    <li>
      <span>3</span>
      <h3><%= t("landing.walkthrough.step3") %></h3>
      <p><%= t("landing.walkthrough.step3_body") %></p>
    </li>
    <li>
      <span>4</span>
      <h3><%= t("landing.walkthrough.step4") %></h3>
      <p><%= t("landing.walkthrough.step4_body") %></p>
    </li>
  </ol>
</section>

<section class="m-wrap m-block">
  <header class="m-block__head">
    <h2><%= t("landing.features.title") %></h2>
  </header>
  <div class="m-split">
    <div class="m-panel">
      <p class="m-tag m-tag--live"><%= t("landing.features.available") %></p>
      <ul>
        <li><%= t("landing.features.f1") %></li>
        <li><%= t("landing.features.f2") %></li>
        <li><%= t("landing.features.f3") %></li>
        <li><%= t("landing.features.f4") %></li>
        <li><%= t("landing.features.f5") %></li>
        <li><%= t("landing.features.f6") %></li>
      </ul>
    </div>
    <div class="m-panel m-panel--quiet">
      <p class="m-tag m-tag--soon"><%= t("landing.features.planned") %></p>
      <ul>
        <li><%= t("landing.features.f7") %></li>
        <li><%= t("landing.features.f8") %></li>
      </ul>
    </div>
  </div>
</section>

<section class="m-wrap m-block">
  <header class="m-block__head">
    <h2><%= t("landing.roles.title") %></h2>
  </header>
  <div class="m-cards">
    <article class="m-card m-card--role">
      <h3><%= t("landing.roles.hq_title") %></h3>
      <p><%= t("landing.roles.hq_body") %></p>
    </article>
    <article class="m-card m-card--role">
      <h3><%= t("landing.roles.region_title") %></h3>
      <p><%= t("landing.roles.region_body") %></p>
    </article>
    <article class="m-card m-card--role">
      <h3><%= t("landing.roles.store_title") %></h3>
      <p><%= t("landing.roles.store_body") %></p>
    </article>
  </div>
</section>

<section class="m-wrap m-block" id="fit">
  <%= render "marketing/prospects" %>
</section>

<section class="m-wrap m-block" id="demo">
  <div class="m-convert">
    <div class="m-convert__copy">
      <h2><%= t("landing.demo.title") %></h2>
      <p><%= t("landing.demo.lede") %></p>
      <ul>
        <li><%= t("landing.demo.point1") %></li>
        <li><%= t("landing.demo.point2") %></li>
        <li><%= t("landing.demo.point3") %></li>
      </ul>
    </div>
    <%= form_with model: @demo_request, url: demo_requests_path, class: "m-form", local: true do |f| %>
      <div class="m-form__row">
        <label>
          <%= t("landing.demo.name") %>
          <%= f.text_field :name, required: true, autocomplete: "name" %>
        </label>
        <label>
          <%= t("landing.demo.company") %>
          <%= f.text_field :company, required: true, autocomplete: "organization" %>
        </label>
      </div>
      <div class="m-form__row">
        <label>
          <%= t("landing.demo.email") %>
          <%= f.email_field :email, autocomplete: "email" %>
        </label>
        <label>
          <%= t("landing.demo.phone") %>
          <%= f.telephone_field :phone, autocomplete: "tel" %>
        </label>
      </div>
      <p class="m-hint"><%= t("landing.demo.contact_hint") %></p>
      <div class="m-form__row">
        <label>
          <%= t("landing.demo.stores") %>
          <%= f.number_field :store_count, min: 1, step: 1 %>
        </label>
        <label>
          <%= t("landing.demo.language") %>
          <%= f.select :preferred_locale, User::LOCALES.map { |code| [t("locales.#{code}"), code] } %>
        </label>
      </div>
      <button type="submit" class="m-btn m-btn--block"><%= t("landing.demo.submit") %></button>
    <% end %>
  </div>
</section>
