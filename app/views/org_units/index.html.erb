<% content_for :title, "#{t('org_units.title')} · Vazivo" %>

<h1><%= t("org_units.title") %></h1>
<p class="lede"><%= t("org_units.lede", tenant: current_tenant.name) %></p>

<% if @region %>
  <section class="panel store-status-list">
    <div class="store-status-list__head">
      <strong><%= @region.name %></strong>
      <%= link_to t("morocco.hq.store_status.all_units"), org_units_path, class: "meta" %>
    </div>
    <% if @region_rows.any? %>
      <ul class="store-status-list__items">
        <% @region_rows.each do |row| %>
          <li>
            <strong><%= row.store.name %></strong>
            <span class="meta"><%= t("morocco.hq.task_monitoring.store_line", done: row.done, total: row.total, percent: row.percent) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty"><%= t("morocco.hq.task_monitoring.region_empty") %></p>
    <% end %>
  </section>
<% elsif @status %>
  <section class="panel store-status-list">
    <div class="store-status-list__head">
      <span class="store-status-badge store-status-badge--<%= @status %>"><%= t("morocco.hq.store_status.#{@status}") %></span>
      <%= link_to t("morocco.hq.store_status.all_units"), org_units_path, class: "meta" %>
    </div>
    <% if @status_stores.any? %>
      <ul class="store-status-list__items">
        <% @status_stores.each do |store| %>
          <li>
            <strong><%= store.name %></strong>
            <span class="meta"><%= store.parent&.name || "-" %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty"><%= t("morocco.hq.store_status.empty") %></p>
    <% end %>
  </section>
<% else %>
<section class="panel">
  <% if @roots.any? %>
    <ul class="tree">
      <% @roots.each do |region| %>
        <li>
          <div class="tree-item">
            <span class="tree-type"><%= region.unit_type %></span>
            <strong><%= region.name %></strong>
          </div>
          <% if region.children.any? %>
            <ul>
              <% region.children.each do |area| %>
                <li>
                  <div class="tree-item">
                    <span class="tree-type"><%= area.unit_type %></span>
                    <%= area.name %>
                  </div>
                  <% if area.children.any? %>
                    <ul>
                      <% area.children.each do |store| %>
                        <li>
                          <div class="tree-item">
                            <span class="tree-type"><%= store.unit_type %></span>
                            <%= store.name %>
                          </div>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t("org_units.empty") %></p>
  <% end %>
</section>
<% end %>
