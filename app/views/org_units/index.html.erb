<% content_for :title, "#{t('org_units.title')} · Vazivo" %>

<h1><%= t("org_units.title") %></h1>
<p class="lede"><%= t("org_units.lede", tenant: current_tenant.name) %></p>

<section class="panel">
  <% if @roots.any? %>
    <ul class="tree">
      <% @roots.each do |region| %>
        <li>
          <div class="tree-item">
            <span class="tree-type"><%= region.unit_type %></span>
            <strong><%= region.name %></strong>
          </div>
          <% if region.children.any? %>
            <ul>
              <% region.children.each do |area| %>
                <li>
                  <div class="tree-item">
                    <span class="tree-type"><%= area.unit_type %></span>
                    <%= area.name %>
                  </div>
                  <% if area.children.any? %>
                    <ul>
                      <% area.children.each do |store| %>
                        <li>
                          <div class="tree-item">
                            <span class="tree-type"><%= store.unit_type %></span>
                            <%= store.name %>
                          </div>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t("org_units.empty") %></p>
  <% end %>
</section>
