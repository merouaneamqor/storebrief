<% content_for :title, "#{t('task_templates.title')} · Vazivo" %>

<header class="radar-head">
  <div>
    <p class="meta"><%= link_to t("task_templates.back_briefs"), communications_path %></p>
    <h1><%= t("task_templates.title") %></h1>
    <p class="lede"><%= t("task_templates.lede", tenant: current_tenant.name) %></p>
  </div>
  <%= link_to t("task_templates.new"), new_task_template_path, class: "btn btn--primary" %>
</header>

<% if @templates.any? %>
  <div class="template-grid">
    <% @templates.each do |template| %>
      <div class="template-card">
        <span class="badge"><%= localized_badge(template.format) %></span>
        <h3><%= template.title %></h3>
        <p class="meta"><%= template.body.to_s.truncate(120).presence || "-" %></p>
        <p class="meta">
          <%= priority_badge(template.priority) if template.format == "task" %>
          <%= t("task_templates.question_count", count: template.question_count) %>
        </p>
        <div class="template-card__actions">
          <%= button_to t("task_templates.use"), use_task_template_path(template), method: :post, class: "btn" %>
          <%= link_to t("task_templates.edit"), edit_task_template_path(template), class: "btn btn--ghost" %>
          <%= button_to t("task_templates.delete"), task_template_path(template), method: :delete, class: "btn btn--ghost",
                form: { data: { turbo_confirm: t("task_templates.delete_confirm", title: template.title) } } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="empty"><%= t("task_templates.empty") %></p>
<% end %>
