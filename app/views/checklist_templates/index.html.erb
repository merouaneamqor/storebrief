<% content_for :title, "#{t('templates.title')} · Vazivo" %>

<header class="radar-head">
  <div>
    <h1><%= t("templates.title") %></h1>
    <p class="lede"><%= t("templates.lede", tenant: current_tenant.name) %></p>
  </div>
  <%= link_to t("templates.new"), new_template_path, class: "btn btn--primary" %>
</header>

<% if @templates.any? %>
  <div class="template-grid">
    <% @templates.each do |template| %>
      <div class="template-card">
        <span class="badge"><%= t("templates.categories.#{template.category}") %></span>
        <h3><%= template.title %></h3>
        <p class="meta"><%= template.description %></p>
        <p class="meta"><%= t("templates.question_count", count: template.question_count) %></p>
        <div class="template-card__actions">
          <%= button_to t("templates.use"), use_template_path(template), method: :post, class: "btn" %>
          <%= link_to t("templates.edit"), edit_template_path(template), class: "btn btn--ghost" %>
          <%= button_to t("templates.delete"), template_path(template), method: :delete, class: "btn btn--ghost",
                form: { data: { turbo_confirm: t("templates.delete_confirm", title: template.title) } } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state", icon: "check-circle", text: t("templates.empty"),
        action_label: t("templates.new"), action_path: new_template_path %>
<% end %>
