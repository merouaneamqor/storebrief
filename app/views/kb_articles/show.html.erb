<% content_for :title, "#{@article.title} · Vazivo" %>

<header class="radar-head">
  <div>
    <p class="meta"><%= link_to t("morocco.kb.articles.back"), kb_articles_path %></p>
    <h1><%= @article.title %></h1>
    <p class="meta">
      <span class="badge badge--<%= @article.publish_state %>"><%= t("morocco.kb.articles.states.#{@article.publish_state}") %></span>
      <%= t("morocco.kb.articles.version_label", version: @article.version) %>
      · <%= @article.kb_category&.title.presence || "-" %>
    </p>
  </div>
  <div class="cluster">
    <%= link_to t("morocco.kb.articles.edit"), edit_kb_article_path(@article), class: "btn" %>
    <% if @article.published? %>
      <%= button_to t("morocco.kb.articles.publish"), publish_kb_article_path(@article), method: :post, class: "btn btn--primary" %>
      <%= button_to t("morocco.kb.articles.unpublish"), unpublish_kb_article_path(@article), method: :post, class: "btn btn--ghost" %>
      <%= button_to t("morocco.kb.articles.archive"), archive_kb_article_path(@article), method: :post, class: "btn btn--ghost" %>
    <% elsif @article.archived? %>
      <%= button_to t("morocco.kb.articles.publish"), publish_kb_article_path(@article), method: :post, class: "btn btn--primary" %>
    <% else %>
      <%= button_to t("morocco.kb.articles.publish"), publish_kb_article_path(@article), method: :post, class: "btn btn--primary" %>
      <%= button_to t("morocco.kb.articles.archive"), archive_kb_article_path(@article), method: :post, class: "btn btn--ghost" %>
    <% end %>
    <%= button_to t("morocco.kb.articles.delete"), kb_article_path(@article), method: :delete, class: "btn btn--ghost",
          form: { data: { turbo_confirm: t("morocco.kb.articles.delete_confirm", title: @article.title) } } %>
  </div>
</header>

<section class="panel stack">
  <h2 class="meta"><%= t("morocco.kb.articles.body") %></h2>
  <div class="lede" style="white-space:pre-wrap;"><%= @article.body.presence || "-" %></div>
  <% if @article.title_ar.present? || @article.body_ar.present? %>
    <hr>
    <h2 class="meta"><%= t("morocco.kb.articles.ar_preview") %></h2>
    <p dir="rtl" lang="ar"><strong><%= @article.title_ar.presence || "-" %></strong></p>
    <div dir="rtl" lang="ar" style="white-space:pre-wrap;"><%= @article.body_ar.presence || "-" %></div>
  <% end %>
</section>

<% if @versions.any? %>
  <section class="panel stack">
    <h2><%= t("morocco.kb.articles.versions_title") %></h2>
    <ul class="stack" style="list-style:none; padding:0; margin:0;">
      <% @versions.each do |version| %>
        <li class="meta">
          <%= t("morocco.kb.articles.version_label", version: version.version) %>
          · <%= version.published_at&.to_date || version.created_at.to_date %>
          · <%= version.title %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
