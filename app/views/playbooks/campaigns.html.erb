<% content_for :title, "#{t('morocco.playbooks.campaigns.title')} · Vazivo" %>
<% snapshot = @dashboard %>
<% regional = @regional %>

<header class="radar-head">
  <div>
    <p class="meta"><%= link_to t("morocco.playbooks.back"), playbooks_path %></p>
    <h1><%= t("morocco.playbooks.campaigns.title") %></h1>
    <p class="meta"><%= t("morocco.playbooks.campaigns.lede") %></p>
  </div>
  <div class="radar-head__actions">
    <%= link_to closing_reports_playbooks_path, class: "btn btn--quiet" do %>
      <%= icon("trophy", css_class: "icon") %> <%= t("morocco.playbooks.closing.nav") %>
    <% end %>
  </div>
</header>

<% if snapshot.campaigns.any? %>
  <section class="cmp-board" x-data="{ dim: 'campaign', onlyExceptions: false, open: null }">
    <div class="cmp-summary">
      <div class="cmp-summary__tile">
        <strong><%= snapshot.campaigns.size %></strong>
        <span><%= t("morocco.playbooks.campaigns.active") %></span>
      </div>
      <div class="cmp-summary__tile">
        <strong><%= snapshot.percent %><small>%</small></strong>
        <span><%= t("morocco.playbooks.campaigns.compliance") %></span>
      </div>
      <div class="cmp-summary__tile cmp-summary__tile--late">
        <strong><%= snapshot.exception_count %></strong>
        <span><%= t("morocco.playbooks.campaigns.exceptions") %></span>
      </div>
      <button type="button" class="btn btn--quiet cmp-summary__filter" :aria-pressed="onlyExceptions" @click="onlyExceptions = !onlyExceptions" x-show="dim === 'campaign'">
        <span x-show="!onlyExceptions"><%= t("morocco.playbooks.campaigns.only_exceptions") %></span>
        <span x-show="onlyExceptions" x-cloak><%= t("morocco.playbooks.campaigns.show_all") %></span>
      </button>
    </div>

    <div class="hq-monitor__dims" role="tablist" aria-label="<%= t('morocco.playbooks.campaigns.dimensions') %>">
      <button type="button"
              class="hq-pulse__tile"
              role="tab"
              :aria-selected="dim === 'campaign'"
              :class="{ 'is-active': dim === 'campaign' }"
              @click="dim = 'campaign'; open = null">
        <strong><%= snapshot.campaigns.size %></strong>
        <span><%= t("morocco.playbooks.campaigns.by_campaign") %></span>
      </button>
      <button type="button"
              class="hq-pulse__tile"
              role="tab"
              :aria-selected="dim === 'region'"
              :class="{ 'is-active': dim === 'region' }"
              @click="dim = 'region'; onlyExceptions = false; open = null">
        <strong><%= regional.regions.size %></strong>
        <span><%= t("morocco.playbooks.campaigns.by_region") %></span>
      </button>
    </div>

    <div class="cmp-campaigns" x-show="dim === 'campaign'">
      <% snapshot.campaigns.each do |campaign| %>
        <article class="cmp-card" x-show="!onlyExceptions || <%= campaign.exceptions.any? %>" x-transition.opacity.duration.150ms>
          <div class="cmp-card__head">
            <div>
              <h2><%= link_to campaign.title, campaign.path %></h2>
              <p class="meta">
                <% if campaign.starts_on.present? && campaign.campaign_on.present? %>
                  <%= t("morocco.playbooks.campaigns.date_range",
                        start: l(campaign.starts_on, format: "%d/%m/%Y"),
                        end: l(campaign.campaign_on, format: "%d/%m/%Y")) %>
                <% else %>
                  <%= t("morocco.playbooks.campaigns.campaign_day") %>:
                  <%= campaign.campaign_on ? l(campaign.campaign_on, format: "%d/%m/%Y") : "-" %>
                <% end %>
                · <%= t("morocco.playbooks.campaigns.stores_done", done: campaign.done, total: campaign.total) %>
              </p>
            </div>
            <div class="cmp-card__percent" role="img" aria-label="<%= campaign.percent %>%">
              <strong><%= campaign.percent %><span>%</span></strong>
              <em><%= t("morocco.playbooks.campaigns.compliance") %></em>
            </div>
          </div>
          <%= render "shared/progress", stats: { done: campaign.done, total: campaign.total, percent: campaign.percent } %>

          <% if campaign.exceptions.any? %>
            <p class="section-title"><%= t("morocco.playbooks.campaigns.exceptions") %> (<%= campaign.exceptions.size %>)</p>
            <ul class="exception-list exception-list--rich">
              <% campaign.exceptions.each do |row| %>
                <li class="exception-row exception-row--<%= row.tone %>">
                  <div class="exception-list__main">
                    <div class="exception-row__top">
                      <span class="tone tone--<%= row.tone %>"><%= tone_icon(row.tone) %> <%= t("morocco.tone.#{row.tone}") %></span>
                    </div>
                    <%= link_to row.store_name, row.path, class: "exception-row__store" %>
                    <div class="meta">
                      <%= row.owner_name %>
                      · <% if row.due_at %><%= icon("clock", css_class: "icon icon--sm") %> <%= morocco_due_label(row.due_at) %><% else %>-<% end %>
                      · <%= t("morocco.playbooks.campaigns.steps_done", done: row.steps_done, total: row.steps_total) %>
                    </div>
                  </div>
                  <%= link_to t("morocco.radar.open"), row.path, class: "btn btn--ghost" %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="meta cmp-card__clear"><%= icon("check-circle", css_class: "icon icon--sm") %> <%= t("morocco.playbooks.campaigns.on_track") %></p>
          <% end %>
        </article>
      <% end %>
    </div>

    <section class="hq-monitor cmp-regional" x-show="dim === 'region'" x-cloak aria-label="<%= t('morocco.playbooks.campaigns.by_region') %>">
      <div class="hq-monitor__summary">
        <div class="hq-monitor__copy">
          <p class="section-title"><%= t("morocco.playbooks.campaigns.regional_title") %></p>
          <p class="hq-monitor__lede"><%= t("morocco.playbooks.campaigns.regional_lede") %></p>
          <p class="meta">
            <%= t("morocco.playbooks.campaigns.stores_done", done: regional.done, total: regional.total) %>
            <% if regional.overdue.positive? %>
              · <span class="hq-monitor__late"><%= t("morocco.hq.monitoring.overdue_line", count: regional.overdue) %></span>
            <% end %>
          </p>
        </div>
        <div class="hq-campaign__meter" role="img" aria-label="<%= regional.percent %>%">
          <div class="hq-campaign__ring" style="--pct: <%= regional.percent %>;">
            <strong><%= regional.percent %><span>%</span></strong>
            <em><%= t("morocco.playbooks.campaigns.compliance") %></em>
          </div>
        </div>
      </div>

      <div class="hq-monitor__groups">
        <ul class="hq-monitor__list" aria-label="<%= t('morocco.playbooks.campaigns.regional_title') %>">
          <% regional.regions.each do |region| %>
            <li class="hq-monitor__row">
              <div class="hq-monitor__toggle">
                <button type="button"
                        class="hq-monitor__expand"
                        :aria-expanded="open === '<%= region.id %>'"
                        @click="open = open === '<%= region.id %>' ? null : '<%= region.id %>'">
                  <div class="hq-monitor__toggle-main">
                    <strong class="hq-monitor__label"><%= region.label %></strong>
                    <span class="meta">
                      <%= t("morocco.playbooks.campaigns.stores_done", done: region.done, total: region.total) %>
                      <% if region.overdue.positive? %>
                        · <span class="hq-monitor__late"><%= t("morocco.hq.monitoring.overdue_line", count: region.overdue) %></span>
                      <% end %>
                    </span>
                  </div>
                  <span class="hq-monitor__pct" aria-hidden="true"><%= region.percent %>%</span>
                </button>
              </div>
              <div class="hq-monitor__stores" x-show="open === '<%= region.id %>'" x-cloak x-transition.opacity.duration.150ms>
                <ul class="exception-list exception-list--rich">
                  <% region.stores.each do |store| %>
                    <li class="exception-row exception-row--<%= store.tone %>">
                      <div class="exception-list__main">
                        <div class="exception-row__top">
                          <span class="tone tone--<%= store.tone %>"><%= tone_icon(store.tone) %> <%= t("morocco.tone.#{store.tone}") %></span>
                          <% if store.overdue %>
                            <span class="exception-kind exception-kind--overdue"><%= t("morocco.hq.board_overdue") %></span>
                          <% elsif store.finished %>
                            <span class="exception-kind"><%= t("morocco.tone.done") %></span>
                          <% end %>
                        </div>
                        <%= link_to store.store_name, store.path, class: "exception-row__store" %>
                        <div class="meta">
                          <%= store.owner_name %>
                          · <% if store.due_at %><%= icon("clock", css_class: "icon icon--sm") %> <%= morocco_due_label(store.due_at) %><% else %>-<% end %>
                          · <%= store.campaign_title %>
                          · <%= t("morocco.playbooks.campaigns.steps_done", done: store.steps_done, total: store.steps_total) %>
                        </div>
                      </div>
                      <%= link_to t("morocco.radar.open"), store.path, class: "btn btn--ghost" %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  </section>
<% else %>
  <div class="empty empty--alive">
    <%= icon("activity", css_class: "icon empty__icon") %>
    <p class="empty__text"><%= t("morocco.playbooks.campaigns.empty") %></p>
    <%= link_to t("morocco.playbooks.title"), playbooks_path, class: "btn btn--quiet" %>
  </div>
<% end %>
