<% report = @report %>
<% export = @export %>
<% content_for :title, "#{t('morocco.playbooks.closing.report_title', title: report.title)} · Vazivo" %>

<header class="radar-head <%= 'clos-export__head' if export %>">
  <div>
    <% unless export %>
      <p class="meta">
        <%= link_to t("morocco.playbooks.closing.title"), closing_reports_playbooks_path %>
        · <%= link_to t("morocco.playbooks.campaigns.nav"), campaigns_playbooks_path %>
      </p>
    <% end %>
    <h1><%= t("morocco.playbooks.closing.report_title", title: report.title) %></h1>
    <p class="meta">
      <% if report.starts_on.present? && report.campaign_on.present? %>
        <%= t("morocco.playbooks.campaigns.date_range",
              start: l(report.starts_on, format: "%d/%m/%Y"),
              end: l(report.campaign_on, format: "%d/%m/%Y")) %>
      <% elsif report.campaign_on %>
        <%= t("morocco.playbooks.campaigns.campaign_day") %>: <%= l(report.campaign_on, format: "%d/%m/%Y") %>
      <% else %>
        -
      <% end %>
      · <%= t("morocco.playbooks.closing.generated_on", date: l(Date.current, format: "%d/%m/%Y")) %>
    </p>
  </div>
  <% unless export %>
    <div class="radar-head__actions">
      <%= link_to t("morocco.playbooks.closing.export_html"), report.export_path, class: "btn btn--quiet", target: "_blank", rel: "noopener" %>
      <%= link_to t("morocco.radar.open"), checklist_path(report.checklist), class: "btn btn--ghost" %>
    </div>
  <% else %>
    <div class="clos-export__print no-print">
      <button type="button" class="btn btn--quiet" onclick="window.print()"><%= t("morocco.playbooks.closing.print") %></button>
    </div>
  <% end %>
</header>

<section class="cmp-board clos-report <%= 'clos-report--export' if export %>">
  <div class="cmp-summary clos-summary">
    <div class="cmp-summary__tile">
      <strong><%= report.percent %><small>%</small></strong>
      <span><%= t("morocco.playbooks.campaigns.compliance") %></span>
    </div>
    <div class="cmp-summary__tile">
      <strong><%= report.done %><small>/<%= report.total %></small></strong>
      <span><%= t("morocco.playbooks.closing.stores_finished") %></span>
    </div>
    <div class="cmp-summary__tile">
      <strong><%= report.on_time %></strong>
      <span><%= t("morocco.playbooks.closing.on_time") %></span>
    </div>
    <div class="cmp-summary__tile <%= 'cmp-summary__tile--late' if report.pending.positive? || report.late.positive? %>">
      <strong><%= report.pending %></strong>
      <span><%= t("morocco.playbooks.closing.still_open") %></span>
    </div>
  </div>

  <div class="clos-split">
    <section class="clos-panel" aria-labelledby="clos-top">
      <h2 id="clos-top" class="section-title"><%= t("morocco.playbooks.closing.top_stores") %></h2>
      <% if report.top_stores.any? %>
        <ol class="clos-rank">
          <% report.top_stores.each_with_index do |row, index| %>
            <li class="clos-rank__row">
              <span class="clos-rank__n" aria-hidden="true"><%= index + 1 %></span>
              <div class="clos-rank__main">
                <% if export %>
                  <strong class="clos-rank__store"><%= row.store_name %></strong>
                <% else %>
                  <%= link_to row.store_name, row.path, class: "clos-rank__store" %>
                <% end %>
                <p class="meta">
                  <%= row.owner_name %>
                  · <%= t("morocco.playbooks.campaigns.steps_done", done: row.steps_done, total: row.steps_total) %>
                  · <span class="tone tone--<%= row.tone %>"><%= t("morocco.tone.#{row.tone}") %></span>
                  <% if row.finished && row.on_time %>
                    · <%= t("morocco.playbooks.closing.badge_on_time") %>
                  <% elsif row.finished %>
                    · <%= t("morocco.playbooks.closing.badge_late_finish") %>
                  <% end %>
                </p>
              </div>
              <strong class="clos-rank__pct"><%= row.step_percent %>%</strong>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="meta"><%= t("morocco.playbooks.closing.no_stores") %></p>
      <% end %>
    </section>

    <section class="clos-panel" aria-labelledby="clos-bottom">
      <h2 id="clos-bottom" class="section-title"><%= t("morocco.playbooks.closing.bottom_stores") %></h2>
      <% if report.bottom_stores.any? %>
        <ol class="clos-rank">
          <% report.bottom_stores.each_with_index do |row, index| %>
            <li class="clos-rank__row">
              <span class="clos-rank__n" aria-hidden="true"><%= index + 1 %></span>
              <div class="clos-rank__main">
                <% if export %>
                  <strong class="clos-rank__store"><%= row.store_name %></strong>
                <% else %>
                  <%= link_to row.store_name, row.path, class: "clos-rank__store" %>
                <% end %>
                <p class="meta">
                  <%= row.owner_name %>
                  · <%= t("morocco.playbooks.campaigns.steps_done", done: row.steps_done, total: row.steps_total) %>
                  · <span class="tone tone--<%= row.tone %>"><%= t("morocco.tone.#{row.tone}") %></span>
                </p>
              </div>
              <strong class="clos-rank__pct"><%= row.step_percent %>%</strong>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="meta"><%= t("morocco.playbooks.closing.no_stores") %></p>
      <% end %>
    </section>
  </div>

  <section class="clos-panel clos-panel--all" aria-labelledby="clos-all">
    <h2 id="clos-all" class="section-title"><%= t("morocco.playbooks.closing.all_stores") %></h2>
    <ul class="exception-list exception-list--rich">
      <% report.stores.each do |row| %>
        <li class="exception-row exception-row--<%= row.tone %>">
          <div class="exception-list__main">
            <div class="exception-row__top">
              <span class="tone tone--<%= row.tone %>"><%= tone_icon(row.tone) %> <%= t("morocco.tone.#{row.tone}") %></span>
              <% if row.finished && row.on_time %>
                <span class="exception-kind"><%= t("morocco.playbooks.closing.badge_on_time") %></span>
              <% elsif row.finished %>
                <span class="exception-kind exception-kind--overdue"><%= t("morocco.playbooks.closing.badge_late_finish") %></span>
              <% elsif row.overdue %>
                <span class="exception-kind exception-kind--overdue"><%= t("morocco.hq.board_overdue") %></span>
              <% end %>
            </div>
            <% if export %>
              <strong class="exception-row__store"><%= row.store_name %></strong>
            <% else %>
              <%= link_to row.store_name, row.path, class: "exception-row__store" %>
            <% end %>
            <div class="meta">
              <%= row.owner_name %>
              · <%= t("morocco.playbooks.campaigns.steps_done", done: row.steps_done, total: row.steps_total) %>
            </div>
          </div>
          <% unless export %>
            <%= link_to t("morocco.radar.open"), row.path, class: "btn btn--ghost" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</section>
