<% filter = params[:filter].presence || "all" %>
<% counts = {
  "unconfirmed" => board.unconfirmed.size,
  "overdue" => board.overdue.size,
  "redo" => board.redo.size
} %>
<% decision_count = board.exceptions.size %>
<% hour = Time.current.in_time_zone(Vazivo::Schedule::ZONE).hour %>
<% hello_key = hour < 18 ? "hello" : "hello_evening" %>
<% zone = Vazivo::Schedule::ZONE %>
<% now = Time.current.in_time_zone(zone) %>
<% period_from = l(now.beginning_of_month.to_date, format: :short) %>
<% period_to = l(now.end_of_month.to_date, format: :short) %>
<% status = board.store_status %>
<% status_buckets = %w[on_track attention critical] %>
<% status_max = status_buckets.map { |b| status.count(b) }.max %>
<% status_max = 1 if status_max.zero? %>

<div class="hq-dashboard">
  <header class="hq-dashboard__top">
    <div class="hq-dashboard__top-copy">
      <p class="hq-dashboard__hello"><%= t("morocco.hq.#{hello_key}") %></p>
      <h1 class="hq-dashboard__title"><%= t("morocco.hq.today_title") %></h1>
      <p class="meta hq-dashboard__tenant"><%= current_tenant.name %></p>
    </div>
    <p class="hq-dashboard__period" title="<%= t('morocco.hq.period_this_month') %>">
      <%= icon("calendar", css_class: "icon icon--sm") %>
      <span><%= t("morocco.hq.period_range", from: period_from, to: period_to) %></span>
    </p>
  </header>

  <section class="hq-hero <%= 'hq-hero--clear' if decision_count.zero? %>">
    <div class="hq-hero__copy">
      <p class="section-title hq-hero__label"><%= t("morocco.hq.today_lede") %></p>
      <div class="hq-hero__pulse" aria-live="polite">
        <% if decision_count.positive? %>
          <strong class="hq-hero__count"><%= decision_count %></strong>
          <span><%= t("morocco.hq.decision_count", count: decision_count) %></span>
        <% else %>
          <strong class="hq-hero__count hq-hero__count--ok"><%= icon("check-circle", css_class: "icon icon--lg") %></strong>
          <span><%= t("morocco.hq.decision_clear") %></span>
        <% end %>
      </div>
    </div>
    <div class="hq-hero__actions">
      <%= link_to new_communication_path, class: "btn btn--primary" do %>
        <%= icon("plus", css_class: "icon") %>
        <%= t("nav.compose") %>
      <% end %>
      <details class="hq-overflow">
        <summary aria-label="<%= t('morocco.hq.more') %>">
          <%= icon("more-horizontal", css_class: "icon") %>
          <span class="meta"><%= t("morocco.hq.more") %></span>
        </summary>
        <div class="hq-overflow__menu">
          <%= link_to playbooks_path, class: "btn btn--quiet" do %>
            <%= icon("book", css_class: "icon") %> <%= t("nav.playbooks") %>
          <% end %>
          <% if current_tenant.feature?(:morocco_ops) %>
            <%= link_to campaigns_playbooks_path, class: "btn btn--quiet" do %>
              <%= icon("activity", css_class: "icon") %> <%= t("morocco.playbooks.campaigns.nav") %>
            <% end %>
          <% end %>
          <%= link_to billing_path, class: "btn btn--quiet" do %>
            <%= icon("credit-card", css_class: "icon") %> <%= t("nav.billing") %>
          <% end %>
          <%= button_to (current_tenant.ramadan_mode? ? t("morocco.ramadan.disable") : t("morocco.ramadan.enable")),
                ramadan_path, method: :patch, class: "btn btn--quiet" %>
        </div>
      </details>
    </div>
  </section>

  <section class="hq-board" x-data="{ filter: '<%= j filter %>' }" x-init="
    $watch('filter', (value) => {
      const url = new URL(window.location.href);
      if (value === 'all') { url.searchParams.delete('filter'); }
      else { url.searchParams.set('filter', value); }
      window.history.replaceState({}, '', url);
    })
  ">
    <div class="hq-pulse hq-dashboard__kpi" role="tablist" aria-label="<%= t('morocco.hq.exceptions') %>">
      <button type="button" class="hq-pulse__tile hq-dashboard__kpi-card" role="tab" :aria-selected="filter === 'all'" :class="{ 'is-active': filter === 'all' }" @click="filter = 'all'">
        <span class="hq-dashboard__kpi-label"><%= t("morocco.hq.filter_all") %></span>
        <strong><%= decision_count %></strong>
        <%= render "dashboard/dashboard_sparkline", variant: :volatile %>
      </button>
      <button type="button" class="hq-pulse__tile hq-pulse__tile--warn hq-dashboard__kpi-card" role="tab" :aria-selected="filter === 'unconfirmed'" :class="{ 'is-active': filter === 'unconfirmed' }" @click="filter = 'unconfirmed'">
        <span class="hq-dashboard__kpi-label"><%= t("morocco.hq.board_unconfirmed") %></span>
        <strong><%= counts["unconfirmed"] %></strong>
        <%= render "dashboard/dashboard_sparkline", variant: :up %>
      </button>
      <button type="button" class="hq-pulse__tile hq-pulse__tile--late hq-dashboard__kpi-card" role="tab" :aria-selected="filter === 'overdue'" :class="{ 'is-active': filter === 'overdue' }" @click="filter = 'overdue'">
        <span class="hq-dashboard__kpi-label"><%= t("morocco.hq.board_overdue") %></span>
        <strong><%= counts["overdue"] %></strong>
        <%= render "dashboard/dashboard_sparkline", variant: :down %>
      </button>
      <button type="button" class="hq-pulse__tile hq-pulse__tile--urgent hq-dashboard__kpi-card" role="tab" :aria-selected="filter === 'redo'" :class="{ 'is-active': filter === 'redo' }" @click="filter = 'redo'">
        <span class="hq-dashboard__kpi-label"><%= t("morocco.hq.board_redo") %></span>
        <strong><%= counts["redo"] %></strong>
        <%= render "dashboard/dashboard_sparkline", variant: :default %>
      </button>
    </div>

    <div class="hq-dashboard__grid hq-dashboard__grid--analytics">
      <% if board.awareness_brief && board.awareness_rollup %>
        <% rollup = board.awareness_rollup %>
        <% total = rollup[:total].to_i %>
        <% received = (rollup["received"] || rollup[:received] || 0).to_i %>
        <% pct = total.zero? ? 0 : ((received.to_f / total) * 100).round %>
        <section class="hq-campaign hq-dashboard__card">
          <div class="hq-dashboard__card-head">
            <div>
              <p class="section-title"><%= t("morocco.hq.latest") %></p>
              <h2 class="hq-campaign__title"><%= link_to board.awareness_brief.title, board.awareness_brief %></h2>
            </div>
            <span class="hq-dashboard__chip"><%= t("morocco.hq.period_this_month") %></span>
          </div>
          <p class="meta hq-campaign__meta"><%= t("morocco.hq.received_line", done: received, total: total) %></p>
          <div class="hq-dashboard__awareness-chart" role="img" aria-label="<%= pct %>%">
            <div class="hq-dashboard__awareness-fill" style="--pct: <%= pct %>;"></div>
            <div class="hq-dashboard__awareness-axis">
              <span>0%</span>
              <span>25%</span>
              <span>50%</span>
              <span>75%</span>
              <span>100%</span>
            </div>
          </div>
          <div class="hq-campaign__track">
            <%= render "shared/awareness_progress", rollup: rollup %>
            <% pending_push = board.awareness_brief.deliveries.count(&:pending?) %>
            <% if pending_push.positive? && current_tenant.feature?(:push_alerts) %>
              <div class="hq-push-remind">
                <%= button_to notify_push_communication_path(board.awareness_brief),
                      method: :post,
                      class: "btn",
                      data: { turbo_confirm: t("communications.notify_push_confirm", count: pending_push) } do %>
                  <%= icon("send", css_class: "icon") %>
                  <%= t("communications.notify_push") %>
                <% end %>
                <p class="meta"><%= t("communications.notify_push_hint", count: pending_push) %></p>
              </div>
            <% end %>
          </div>
        </section>
      <% else %>
        <section class="hq-dashboard__card hq-dashboard__card--empty">
          <p class="section-title"><%= t("morocco.hq.latest") %></p>
          <p class="meta"><%= t("morocco.hq.board_clear") %></p>
        </section>
      <% end %>

      <section class="hq-status-strip hq-dashboard__card" aria-label="<%= t('morocco.hq.store_status.title') %>">
        <div class="hq-dashboard__card-head">
          <p class="section-title"><%= t("morocco.hq.store_status.title") %></p>
          <%= link_to t("morocco.hq.view_all_stores"), org_units_path, class: "hq-dashboard__link" %>
        </div>
        <ul class="hq-dashboard__bars">
          <% status_buckets.each do |bucket| %>
            <% count = status.count(bucket) %>
            <li>
              <%= link_to org_units_path(status: bucket), class: "hq-dashboard__bar-row hq-dashboard__bar-row--#{bucket}" do %>
                <span class="hq-dashboard__bar-label"><%= t("morocco.hq.store_status.#{bucket}") %></span>
                <span class="hq-dashboard__bar-track">
                  <span class="hq-dashboard__bar-fill" style="width: <%= (count.to_f / status_max * 100).round %>%"></span>
                </span>
                <span class="hq-dashboard__bar-value"><%= count %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    </div>

    <div class="hq-dashboard__grid hq-dashboard__grid--split">
      <div class="hq-exceptions hq-dashboard__card">
        <div class="hq-dashboard__card-head">
          <p class="section-title"><%= t("morocco.hq.exceptions") %></p>
        </div>
        <% if board.exceptions.any? %>
          <div class="hq-dashboard__table-wrap">
            <table class="hq-dashboard__table exception-list exception-list--rich">
              <thead>
                <tr>
                  <th scope="col"><%= t("morocco.hq.table_kind") %></th>
                  <th scope="col"><%= t("morocco.hq.table_store") %></th>
                  <th scope="col"><%= t("morocco.hq.table_owner") %></th>
                  <th scope="col"><%= t("morocco.hq.table_status") %></th>
                  <th scope="col" class="hq-dashboard__table-action"><span class="visually-hidden"><%= t("morocco.radar.open") %></span></th>
                </tr>
              </thead>
              <tbody>
                <% board.exceptions.each do |row| %>
                  <tr class="exception-row exception-row--<%= row.tone %>" x-show="filter === 'all' || filter === '<%= row.kind %>'" x-transition.opacity.duration.150ms>
                    <td>
                      <span class="exception-kind exception-kind--<%= row.kind %>"><%= t("morocco.hq.board_#{row.kind == 'redo' ? 'redo' : row.kind == 'overdue' ? 'overdue' : 'unconfirmed'}") %></span>
                    </td>
                    <td><%= link_to row.store_name, row.path, class: "exception-row__store" %></td>
                    <td class="meta"><%= row.owner_name %></td>
                    <td>
                      <span class="hq-dashboard__status hq-dashboard__status--<%= row.tone %>"><%= row.status_label %></span>
                    </td>
                    <td class="hq-dashboard__table-action">
                      <%= link_to t("morocco.radar.open"), row.path, class: "btn btn--ghost" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty empty--alive">
            <%= icon("check-circle", css_class: "icon empty__icon") %>
            <p class="empty__text"><%= t("morocco.hq.exceptions_empty") %></p>
          </div>
        <% end %>
      </div>

      <aside class="hq-dashboard__card hq-dashboard__activity" aria-label="<%= t('morocco.hq.activity_feed') %>">
        <div class="hq-dashboard__card-head">
          <p class="section-title"><%= t("morocco.hq.activity_feed") %></p>
        </div>
        <% if board.exceptions.any? %>
          <ul class="hq-dashboard__activity-list">
            <% board.exceptions.first(5).each do |row| %>
              <li x-show="filter === 'all' || filter === '<%= row.kind %>'" x-transition.opacity.duration.150ms>
                <span class="hq-dashboard__activity-icon" aria-hidden="true"></span>
                <div class="hq-dashboard__activity-body">
                  <p><%= link_to row.store_name, row.path %></p>
                  <p class="meta">
                    <%= t("morocco.hq.board_#{row.kind == 'redo' ? 'redo' : row.kind == 'overdue' ? 'overdue' : 'unconfirmed'}") %>
                    <% if row.due_at %>
                      · <%= morocco_due_label(row.due_at) %>
                    <% end %>
                  </p>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="meta"><%= t("morocco.hq.exceptions_empty") %></p>
        <% end %>
      </aside>
    </div>
  </section>

  <% if board.podium.any? %>
    <section class="hq-podium hq-dashboard__card">
      <div class="hq-podium__head">
        <p class="section-title"><%= icon("trophy", css_class: "icon icon--sm") %> <%= t("morocco.ranking.podium") %></p>
        <%= link_to t("nav.ranking"), ranking_path, class: "hq-dashboard__link" %>
      </div>
      <ol class="podium podium--race">
        <% board.podium.each_with_index do |row, index| %>
          <li class="podium__card podium__card--<%= index + 1 %>">
            <span class="podium__rank"><%= index + 1 %></span>
            <strong><%= row.store.name %></strong>
            <span class="podium__score"><%= row.percent %>%</span>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <p class="hq-footnote"><%= t("morocco.hq.chase") %></p>
</div>
