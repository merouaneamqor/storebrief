<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "StoreBrief" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t('landing.hero.lede') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,560;9..144,700&family=Noto+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "marketing", "data-turbo-track": "reload" %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>
  <body class="marketing <%= 'rtl' if rtl? %>">
    <header class="m-nav" x-data="{ open: false }">
      <div class="m-nav__inner">
        <a href="<%= root_path %>" class="m-brand">
          <span class="m-mark" aria-hidden="true"></span>
          <%= t("landing.hero.brand") %>
        </a>
        <nav class="m-nav__links" :class="{ 'is-open': open }">
          <a href="<%= root_path %>#solutions" @click="open = false"><%= t("landing.nav.solutions") %></a>
          <a href="<%= root_path %>#how" @click="open = false"><%= t("landing.nav.how") %></a>
          <%= link_to t("landing.nav.resources"), resources_path %>
          <%= link_to t("landing.nav.sign_in"), login_path, class: "m-link m-nav__signin" %>
        </nav>
        <div class="m-nav__tools">
          <%= render "shared/locale_switch" %>
          <a href="<%= root_path(anchor: 'demo') %>" class="m-btn m-btn--small m-nav__demo"><%= t("landing.nav.demo") %></a>
          <button type="button" class="m-nav__toggle" @click="open = !open" :aria-expanded="open" aria-label="Menu">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <% if flash[:notice] %>
      <p class="m-flash m-flash--notice"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p class="m-flash m-flash--alert"><%= flash[:alert] %></p>
    <% end %>

    <%= yield %>

    <footer class="m-footer">
      <div class="m-footer__inner">
        <div>
          <a href="<%= root_path %>" class="m-brand"><span class="m-mark" aria-hidden="true"></span><%= t("landing.hero.brand") %></a>
          <p><%= t("landing.footer.tagline") %></p>
        </div>
        <nav class="m-footer__links">
          <a href="<%= root_path %>#how"><%= t("landing.nav.how") %></a>
          <%= link_to t("landing.nav.resources"), resources_path %>
          <%= link_to t("landing.nav.sign_in"), login_path %>
        </nav>
        <a href="<%= root_path(anchor: 'demo') %>" class="m-btn m-btn--small"><%= t("landing.nav.demo") %></a>
      </div>
    </footer>
  </body>
</html>
