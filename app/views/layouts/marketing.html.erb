<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "StoreBrief" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t('landing.hero.lede') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Noto+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "marketing", "data-turbo-track": "reload" %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>
  <body class="marketing <%= 'rtl' if rtl? %>">
    <header class="m-nav" x-data="{ open: false }">
      <a href="<%= root_path %>" class="m-brand"><%= t("landing.hero.brand") %></a>
      <button type="button" class="m-nav__toggle" @click="open = !open" aria-label="Menu">☰</button>
      <nav class="m-nav__links" :class="{ 'is-open': open }">
        <a href="#solutions" @click="open = false"><%= t("landing.nav.solutions") %></a>
        <a href="#how" @click="open = false"><%= t("landing.nav.how") %></a>
        <%= link_to t("landing.nav.resources"), resources_path %>
        <div class="locale-switch">
          <%= button_to "FR", locale_path(locale: "fr"), method: :patch, class: "locale-btn #{'is-active' if I18n.locale.to_s == 'fr'}" %>
          <%= button_to "عربي", locale_path(locale: "ar"), method: :patch, class: "locale-btn #{'is-active' if I18n.locale.to_s == 'ar'}" %>
        </div>
        <%= link_to t("landing.nav.sign_in"), login_path, class: "m-link" %>
        <a href="#demo" class="m-btn m-btn--small" @click="open = false"><%= t("landing.nav.demo") %></a>
      </nav>
    </header>

    <% if flash[:notice] %>
      <p class="m-flash m-flash--notice"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p class="m-flash m-flash--alert"><%= flash[:alert] %></p>
    <% end %>

    <%= yield %>

    <footer class="m-footer" id="resources">
      <div class="m-footer__inner">
        <strong class="m-brand"><%= t("landing.hero.brand") %></strong>
        <p><%= t("landing.footer.tagline") %></p>
        <p class="m-meta">
          <%= link_to t("landing.footer.strategy"), resources_path %>
          ·
          <%= link_to t("landing.nav.sign_in"), login_path %>
        </p>
      </div>
    </footer>
  </body>
</html>
