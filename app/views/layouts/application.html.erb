<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : (current_tenant&.display_brand_name || "StoreBrief") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <% if current_tenant&.favicon&.attached? %>
      <link rel="icon" href="<%= url_for(current_tenant.favicon) %>" type="<%= current_tenant.favicon.content_type %>">
    <% else %>
      <link rel="icon" href="/icon.png" type="image/png">
      <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Noto+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body <%= 'rtl' if rtl? %>"
        <% if current_tenant %>style="<%= current_tenant.brand_style_attribute %>"<% end %>
        x-data="{ navOpen: false, ...offlineSync() }" x-init="init()">
    <% if current_user %>
      <div class="app-shell" :class="{ 'is-nav-open': navOpen }">
        <aside class="app-sidebar">
          <div class="app-sidebar__brand">
            <a href="<%= app_root_path %>" class="app-logo">
              <% if current_tenant.logo.attached? %>
                <%= image_tag current_tenant.logo, class: "app-logo__img", alt: current_tenant.display_brand_name %>
              <% else %>
                <% if current_tenant.logo_mark.attached? %>
                  <%= image_tag current_tenant.logo_mark, class: "app-logo__mark-img", alt: "" %>
                <% else %>
                  <span class="app-logo__mark" aria-hidden="true"></span>
                <% end %>
                <span class="app-logo__name"><%= current_tenant.display_brand_name %></span>
              <% end %>
            </a>
            <% if current_tenant.tagline.present? %>
              <p class="app-sidebar__tagline"><%= current_tenant.tagline %></p>
            <% end %>
            <p class="app-sidebar__tenant"><%= current_tenant.name %></p>
          </div>

          <nav class="app-sidebar__nav">
            <%= link_to t("nav.dashboard"), app_root_path, class: "app-nav-link #{'is-active' if current_page?(app_root_path)}" %>
            <% if hq_user? %>
              <%= link_to t("nav.org_units"), org_units_path, class: "app-nav-link #{'is-active' if request.path.start_with?('/org_units')}" %>
              <%= link_to t("nav.briefs"), communications_path, class: "app-nav-link #{'is-active' if request.path.start_with?('/communications')}" %>
              <%= link_to t("nav.checklists"), checklists_path, class: "app-nav-link #{'is-active' if request.path.start_with?('/checklists') && !request.path.include?('/deliveries')}" %>
              <%= link_to t("nav.templates"), templates_path, class: "app-nav-link #{'is-active' if request.path.start_with?('/templates')}" %>
              <%= link_to t("nav.admin"), admin_root_path, class: "app-nav-link", target: "_top" %>
              <%= link_to t("nav.compose"), new_communication_path, class: "app-nav-link app-nav-link--cta" %>
            <% else %>
              <%= link_to t("nav.inbox"), inbox_index_path, class: "app-nav-link #{'is-active' if request.path.start_with?('/inbox')}" %>
              <%= link_to t("checklists.store_inbox"), checklists_deliveries_path, class: "app-nav-link #{'is-active' if request.path.include?('/deliveries')}" %>
            <% end %>
          </nav>

          <div class="app-sidebar__foot">
            <span class="sync-chip" x-text="online ? '<%= j t('checklists.sync_ok') %>' : '<%= j t('checklists.sync_pending') %>'"
                  :class="online ? 'sync-chip--ok' : 'sync-chip--pending'"></span>
          </div>
        </aside>

        <div class="app-frame">
          <header class="app-topbar">
            <button type="button" class="app-menu-btn" @click="navOpen = !navOpen" :aria-expanded="navOpen" aria-label="Menu">
              <span></span><span></span><span></span>
            </button>
            <div class="app-topbar__spacer"></div>
            <%= render "shared/locale_switch" %>
            <%= button_to t("auth.sign_out"), logout_path, method: :delete, class: "app-signout" %>
          </header>

          <main class="app-content">
            <% if flash[:notice] %>
              <p class="flash flash--notice"><%= flash[:notice] %></p>
            <% end %>
            <% if flash[:alert] %>
              <p class="flash flash--alert"><%= flash[:alert] %></p>
            <% end %>
            <%= yield %>
          </main>
        </div>

        <div class="app-backdrop" @click="navOpen = false" x-show="navOpen" x-cloak></div>
      </div>
    <% else %>
      <main class="app-content app-content--alone">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
