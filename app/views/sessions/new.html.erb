<% content_for :title, "Sign in · StoreBrief" %>

<div class="auth-shell">
  <span class="brand">StoreBrief</span>
  <p class="lede">Brief stores across your retail hierarchy — news and tasks, tenant by tenant.</p>

  <%= form_with url: login_path, method: :post, class: "form-stack", local: true do %>
    <label>
      Tenant slug
      <input type="text" name="tenant_slug" value="<%= params[:tenant_slug] || 'northwind' %>" required autocomplete="organization">
    </label>
    <label>
      Email
      <input type="email" name="email" value="<%= params[:email] %>" required autocomplete="username">
    </label>
    <label>
      Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <div class="actions">
      <button class="btn" type="submit">Sign in</button>
    </div>
  <% end %>

  <div class="hint">
    <p><strong>Northwind Retail</strong> — slug <code>northwind</code><br>
      HQ: <code>hq@northwind.test</code> / <code>password</code><br>
      Store: <code>store@northwind.test</code> / <code>password</code></p>
    <p><strong>Contoso Shops</strong> — slug <code>contoso</code><br>
      HQ: <code>hq@contoso.test</code> / <code>password</code><br>
      Store: <code>store@contoso.test</code> / <code>password</code></p>
  </div>
</div>
