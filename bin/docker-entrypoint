#!/bin/bash -e

if [ -n "${DATABASE_URL}" ]; then
  echo "Waiting for database..."
  until pg_isready -d "${DATABASE_URL}" >/dev/null 2>&1; do
    sleep 1
  done
fi

if [ "${1}" = "./bin/rails" ] && [ "${2}" = "server" ]; then
  # Safety net when the image was built without precompiled CSS (e.g. local volume mounts)
  if [ ! -f app/assets/builds/marketing.css ]; then
    echo "Building CSS/JS assets..."
    ./bin/rails active_admin:bundle_js dartsass:build assets:precompile
  fi

  ./bin/rails db:prepare

  if [ "${SEED_SALES_DEMO:-}" = "1" ]; then
    echo "Seeding sales demo tenant..."
    ./bin/rails sales_demo:seed
  fi
fi

exec "${@}"
